---
import { getCollection } from 'astro:content';

interface Props {
  areaFilter?: string;
  limit?: number;
}

const { areaFilter, limit = 3 } = Astro.props;

let testimonials = await getCollection('testimonials');
if (areaFilter) {
  const filtered = testimonials.filter((t) => t.data.area === areaFilter);
  testimonials = filtered.length ? filtered : testimonials;
}
testimonials = testimonials.slice(0, limit);

function initials(name: string) {
  return name
    .split(' ')
    .map((p) => p[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}
---

<section class="bg-slate-50 py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">What clients say</p>
      <h2 class="mt-2 font-display text-3xl font-bold text-slate-900 sm:text-4xl">
        Real feedback, not empty promises
      </h2>
      <p class="mt-3 text-sm text-slate-500">
        Illustrative placeholder testimonials — to be replaced with real client feedback.
      </p>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        testimonials.map((t) => (
          <figure class="flex h-full flex-col justify-between rounded-2xl border border-slate-100 bg-white p-7 shadow-sm">
            <blockquote class="text-sm leading-relaxed text-slate-600">“{t.data.quote}”</blockquote>
            <figcaption class="mt-6 flex items-center gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-100 font-display text-sm font-bold text-brand-700">
                {initials(t.data.name)}
              </span>
              <span>
                <span class="block text-sm font-semibold text-slate-900">{t.data.name}</span>
                <span class="block text-xs text-slate-500">{t.data.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>
