---
// Two decorative strips scrolling in opposite directions: suburbs from around Australia (shuffled
// on every visit), and the places customers find you. Hidden from screen readers and kept out of
// crawlable text on purpose: these illustrate "wherever people search", they are not a service
// area (see src/lib/au-suburbs.ts).
import { AU_SUBURBS } from '../lib/au-suburbs';

const COUNT = 14;
const initial = AU_SUBURBS.filter((_, i) => i % 2 === 0).slice(0, COUNT);
const channels = ['Google', 'Google Maps', 'ChatGPT', 'Gemini', 'Perplexity', 'AI Overviews'];
---

<div class="border-y-2 border-ink" aria-hidden="true">
  <div class="overflow-hidden bg-sun py-4">
    <div data-suburb-strip class="marquee flex w-max gap-10 whitespace-nowrap font-display text-2xl font-bold text-ink">
      {[...initial, ...initial].map((s) => (
        <span class="flex items-center gap-10"><span data-suburb>{s}</span><span class="h-3 w-3 rounded-full bg-ink"></span></span>
      ))}
    </div>
  </div>
  <div class="overflow-hidden bg-ink py-3 text-white">
    <div class="marquee marquee-reverse flex w-max gap-8 whitespace-nowrap text-lg font-semibold">
      {[...channels, ...channels, ...channels, ...channels].map((c) => (
        <span class="flex items-center gap-8">Found on {c}<span class="text-teal">✦</span></span>
      ))}
    </div>
  </div>
</div>

<script>
  import { AU_SUBURBS } from '../lib/au-suburbs';

  // A fresh random set each visit. Both halves get the same names so the loop stays seamless.
  document.querySelectorAll<HTMLElement>('[data-suburb-strip]').forEach((strip) => {
    const slots = strip.querySelectorAll<HTMLElement>('[data-suburb]');
    const half = slots.length / 2;
    const picks = [...AU_SUBURBS].sort(() => Math.random() - 0.5).slice(0, half);
    slots.forEach((el, i) => (el.textContent = picks[i % half]));
  });
</script>
