---
interface Props {
  heading?: string;
  body?: string;
  ctaLabel?: string;
  ctaHref?: string;
}

const {
  heading = 'Let’s see where you stand.',
  body = 'Send me your website or business name. I’ll come back with what’s working, what isn’t, and what I’d fix first.',
  ctaLabel = 'Get a free audit',
  ctaHref = '/contact/',
} = Astro.props;
---

<section class="px-5 pb-16 pt-6 sm:px-8">
  <div class="relative mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-sun px-8 py-20 text-center sm:px-16">
    <div class="motion-drift absolute -left-16 -top-16 h-56 w-56 rounded-full border-[14px] border-ink/10" aria-hidden="true"></div>
    <div class="motion-drift absolute -bottom-20 -right-10 h-72 w-72 rounded-full bg-teal/40" style="--d:-4s" aria-hidden="true"></div>
    <div class="motion-drift absolute bottom-8 left-[12%] h-10 w-10 rotate-12 rounded-lg bg-coral" style="--d:-2s" aria-hidden="true"></div>
    <h2 data-reveal class="relative font-display text-4xl font-extrabold tracking-tight sm:text-6xl">{heading}</h2>
    <p class="relative mx-auto mt-5 max-w-xl text-lg text-ink">{body}</p>
    <a href={ctaHref} class="btn btn-lg relative mt-9 bg-ink text-white">
      <span>{ctaLabel}</span>
      <span class="btn-dot bg-teal text-ink" aria-hidden="true">→</span>
    </a>
  </div>
</section>
