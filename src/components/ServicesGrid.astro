---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

interface Props {
  areaId?: string;
  heading?: string;
  subheading?: string;
}

const {
  areaId,
  heading = 'Everything for your online visibility, in one place.',
  subheading = 'What I do',
} = Astro.props;

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const iconMap: Record<string, string> = {
  seo: 'lucide:map-pin',
  website: 'lucide:layout-panel-left',
  'ai-visibility': 'lucide:sparkles',
};

// Same colour order and tilts as the homepage service cards.
const looks = [
  { bg: 'bg-sun', dot: 'bg-ink text-sun', tilt: -1.2 },
  { bg: 'bg-teal', dot: 'bg-ink text-teal', tilt: 0.8 },
  { bg: 'bg-coral', dot: 'bg-ink text-coral', tilt: -0.6 },
];
---

<section class="mx-auto max-w-7xl px-5 py-20 sm:px-8">
  <p class="text-sm font-bold uppercase tracking-wider text-slate-500">{subheading}</p>
  <h2 data-reveal class="mt-3 max-w-2xl font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">{heading}</h2>

  <div class="mt-12 grid gap-6 md:grid-cols-3">
    {
      services.map((service, i) => {
        const href = areaId ? `/areas/${areaId}/${service.id}/` : `/services/${service.id}/`;
        const look = looks[i % looks.length];
        return (
          <a
            href={href}
            data-reveal
            style={`--tilt:${look.tilt}deg; --d:${i * 130}ms`}
            class={`tilt-card group flex min-h-[300px] flex-col rounded-[2rem] p-8 text-ink ${look.bg}`}
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-2xl bg-white/60">
              <Icon name={iconMap[service.data.icon]} class="h-6 w-6" />
            </span>
            <h3 class="mt-6 font-display text-2xl font-extrabold leading-tight">{service.data.title}</h3>
            <p class="mt-3 flex-1 leading-relaxed">{service.data.shortDescription}</p>
            <span class={`mt-6 flex h-11 w-11 items-center justify-center rounded-full text-lg font-bold transition-transform group-hover:translate-x-1 ${look.dot}`} aria-hidden="true">→</span>
          </a>
        );
      })
    }
  </div>
</section>
