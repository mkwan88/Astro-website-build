---
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';

interface Props {
  areaId?: string;
  heading?: string;
  subheading?: string;
}

const {
  areaId,
  heading = 'Everything for your online visibility, in one place',
  subheading = 'What we do',
} = Astro.props;

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);

const iconMap: Record<string, string> = {
  seo: 'lucide:map-pin',
  website: 'lucide:layout-panel-left',
  'ai-visibility': 'lucide:sparkles',
};
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">{subheading}</p>
    <h2 class="mt-2 font-display text-3xl font-bold text-slate-900 sm:text-4xl">{heading}</h2>
  </div>

  <div class="mt-14 grid gap-8 md:grid-cols-3">
    {
      services.map((service) => {
        const href = areaId ? `/areas/${areaId}/${service.id}/` : `/services/${service.id}/`;
        return (
          <a
            href={href}
            class="group flex flex-col rounded-2xl border border-slate-100 bg-white p-7 shadow-sm transition-shadow hover:shadow-lg"
          >
            <span class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-600">
              <Icon name={iconMap[service.data.icon]} class="h-6 w-6" />
            </span>
            <h3 class="mt-5 font-display text-lg font-semibold text-slate-900">{service.data.title}</h3>
            <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">{service.data.shortDescription}</p>
            <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 group-hover:gap-2 transition-all">
              Learn more
              <Icon name="lucide:arrow-right" class="h-4 w-4" />
            </span>
          </a>
        );
      })
    }
  </div>
</section>
