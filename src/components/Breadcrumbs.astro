---
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="border-b border-slate-100 bg-slate-50/60">
  <ol class="mx-auto flex max-w-7xl flex-wrap items-center gap-1.5 px-4 py-3 text-xs text-slate-500 sm:px-6 lg:px-8">
    <li><a href="/" class="hover:text-brand-600">Home</a></li>
    {
      items.map((item, i) => (
        <>
          <li aria-hidden="true" class="text-slate-300">/</li>
          <li>
            {i === items.length - 1 ? (
              <span class="font-medium text-slate-700" aria-current="page">{item.name}</span>
            ) : (
              <a href={item.href} class="hover:text-brand-600">{item.name}</a>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
