---
interface Crumb {
  name: string;
  href: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb">
  <ol class="mx-auto flex max-w-7xl flex-wrap items-center gap-2 px-5 pt-4 text-sm text-slate-500 sm:px-8">
    <li><a href="/" class="hover:text-ink">Home</a></li>
    {
      items.map((item, i) => (
        <>
          <li aria-hidden="true" class="h-1.5 w-1.5 rounded-full bg-teal" />
          <li>
            {i === items.length - 1 ? (
              <span class="font-semibold text-ink" aria-current="page">{item.name}</span>
            ) : (
              <a href={item.href} class="hover:text-ink">{item.name}</a>
            )}
          </li>
        </>
      ))
    }
  </ol>
</nav>
