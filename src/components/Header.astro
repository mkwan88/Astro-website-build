---
import Logo from './Logo.astro';
import { NAV_LINKS, SITE } from '../lib/site';

const currentPath = Astro.url.pathname;
---

<header
  data-site-header
  class="group sticky inset-x-0 top-0 z-50 border-b border-transparent bg-cream/90 backdrop-blur transition-colors duration-300 data-[scrolled=true]:border-slate-200"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-4 sm:px-8">
    <a href="/" class="shrink-0" aria-label="Kwantum home">
      <Logo />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Primary">
      {
        NAV_LINKS.map((link) => {
          const isActive = currentPath === link.href || currentPath.startsWith(link.href);
          return (
            <a
              href={link.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'text-[15px] font-medium text-ink underline-offset-8 transition hover:underline hover:decoration-teal hover:decoration-4',
                isActive && 'underline decoration-sun decoration-4',
              ]}
            >
              {link.label}
            </a>
          );
        })
      }
    </nav>

    <div class="hidden items-center gap-3 lg:flex">
      <a href={`tel:${SITE.phone}`} class="text-[15px] font-semibold text-ink hover:text-slate-600">
        {SITE.phoneDisplay}
      </a>
      <a href="/contact/" class="btn bg-ink text-white">
        <span>Free audit</span>
        <span class="btn-dot bg-sun text-ink" aria-hidden="true">→</span>
      </a>
    </div>

    <button
      id="menu-toggle"
      type="button"
      class="inline-flex items-center justify-center rounded-full bg-white p-2.5 text-ink shadow-sm lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Toggle navigation menu"
    >
      <svg id="icon-open" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 7.5h16.5M3.75 12h16.5M3.75 16.5h16.5" />
      </svg>
      <svg id="icon-close" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden border-t border-slate-200 bg-cream lg:hidden">
    <nav class="flex flex-col gap-1 px-5 py-5" aria-label="Mobile">
      {
        NAV_LINKS.map((link) => (
          <a href={link.href} class="rounded-2xl px-4 py-3 font-display text-xl font-bold text-ink hover:bg-white">
            {link.label}
          </a>
        ))
      }
      <a href={`tel:${SITE.phone}`} class="rounded-2xl px-4 py-3 font-semibold text-ink hover:bg-white">
        Call Mark: {SITE.phoneDisplay}
      </a>
      <a href="/contact/" class="btn btn-lg mt-3 justify-between bg-ink text-white">
        <span>Get a free audit</span>
        <span class="btn-dot bg-sun text-ink" aria-hidden="true">→</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');

  if (header) {
    const onScroll = () => (header.dataset.scrolled = String(window.scrollY > 8));
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
  });
</script>
