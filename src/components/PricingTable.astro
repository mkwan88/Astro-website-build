---
import { Icon } from 'astro-icon/components';

const tiers = [
  {
    name: 'Foundation',
    blurb: 'Get the fundamentals working',
    price: '$1,000',
    period: '/month',
    note: 'No lock-in contract',
    featured: false,
    features: [
      'Google Business Profile setup & optimisation',
      'On-page SEO for up to 5 core pages',
      'Up to 10 keywords tracked',
      'Local citation building',
      'Basic technical health check',
      'Monthly report, plain-English, email support',
    ],
  },
  {
    name: 'Momentum',
    blurb: 'Where most businesses see real traction',
    price: '$1,590',
    period: '/month',
    note: 'No lock-in contract',
    featured: true,
    features: [
      'Everything in Foundation',
      'Up to 15 keywords tracked',
      'Monthly Google Business Profile posting',
      '2 blog articles per month',
      'Active local link building & outreach',
      'Quarterly technical SEO audit',
      'AI search (GEO) foundations: schema & FAQ',
      'Phone support',
    ],
  },
  {
    name: 'Authority',
    blurb: 'Become the obvious choice in your market',
    price: 'From $2,950',
    period: '/month',
    note: 'Scoped after a short call',
    featured: false,
    features: [
      'Everything in Momentum',
      '22+ keywords tracked',
      'Full local pack strategy',
      '4 articles/month + digital PR & guest posts',
      'Advanced link acquisition campaign',
      'Ongoing (not quarterly) technical SEO',
      'Full-site AI search (GEO) optimisation',
      'Monthly strategy call, dedicated contact',
    ],
  },
];
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">SEO Pricing</p>
    <h2 class="mt-2 font-display text-3xl font-bold text-slate-900 sm:text-4xl">
      Local SEO & AI search visibility, priced to compete
    </h2>
    <p class="mt-4 text-sm text-slate-500">
      A straight monthly retainer for ongoing SEO work — no setup fee, no 12-month lock-in.
      Website design is priced separately as its own project; see{' '}
      <a href="/pricing/#website-design" class="font-semibold text-brand-600 hover:underline">website design pricing below</a>.
    </p>
    <p class="mt-2 text-xs font-medium uppercase tracking-wide text-slate-400">
      Illustrative pricing — placeholder figures, to be confirmed
    </p>
  </div>

  <div class="mt-14 grid gap-8 lg:grid-cols-3">
    {
      tiers.map((tier) => (
        <div
          class:list={[
            'flex flex-col rounded-3xl border p-8',
            tier.featured
              ? 'border-brand-600 bg-brand-900 text-white shadow-xl'
              : 'border-slate-100 bg-white shadow-sm',
          ]}
        >
          {tier.featured && (
            <span class="mb-4 inline-flex w-fit items-center rounded-full bg-accent-400 px-3 py-1 text-xs font-semibold text-brand-950">
              Most popular
            </span>
          )}
          <h3 class:list={['font-display text-xl font-bold', tier.featured ? 'text-white' : 'text-slate-900']}>
            {tier.name}
          </h3>
          <p class:list={['mt-1 text-sm', tier.featured ? 'text-brand-100' : 'text-slate-500']}>{tier.blurb}</p>

          <div class="mt-6 flex items-baseline gap-1">
            <span class:list={['font-display text-4xl font-extrabold', tier.featured ? 'text-white' : 'text-slate-900']}>
              {tier.price}
            </span>
            <span class:list={['text-sm', tier.featured ? 'text-brand-200' : 'text-slate-400']}>{tier.period}</span>
          </div>
          <p class:list={['mt-1 text-xs', tier.featured ? 'text-brand-200' : 'text-slate-400']}>{tier.note}</p>

          <ul class="mt-6 flex-1 space-y-3">
            {tier.features.map((f) => (
              <li class="flex items-start gap-2.5 text-sm">
                <Icon
                  name="lucide:check"
                  class:list={['mt-0.5 h-4 w-4 shrink-0', tier.featured ? 'text-accent-300' : 'text-accent-600']}
                />
                <span class={tier.featured ? 'text-brand-50' : 'text-slate-600'}>{f}</span>
              </li>
            ))}
          </ul>

          <a
            href="/contact/"
            class:list={[
              'mt-8 inline-flex items-center justify-center rounded-full px-5 py-3 text-sm font-semibold transition-colors',
              tier.featured
                ? 'bg-accent-400 text-brand-950 hover:bg-accent-300'
                : 'bg-brand-600 text-white hover:bg-brand-700',
            ]}
          >
            Get My Free Audit
          </a>
        </div>
      ))
    }
  </div>

  <p class="mt-8 text-center text-xs text-slate-400">
    All prices exclude GST. Offers are intended for businesses (B2B) engaging Kwantum's services.
  </p>
</section>
