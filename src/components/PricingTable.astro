---
import { Icon } from 'astro-icon/components';

const tiers = [
  {
    name: 'Foundation',
    blurb: 'Get the fundamentals working',
    price: '$1,000',
    period: '/month',
    note: '+ one-off setup fee · No lock-in contract',
    featured: false,
    features: [
      'Google Business Profile setup & optimisation',
      'On-page SEO for up to 5 core pages',
      'Up to 10 keywords tracked',
      'Local citation building',
      'Basic technical health check',
      'Monthly report, plain-English, email support',
    ],
  },
  {
    name: 'Momentum',
    blurb: 'Where most businesses see real traction',
    price: '$1,590',
    period: '/month',
    note: '+ one-off setup fee · No lock-in contract',
    featured: true,
    features: [
      'Everything in Foundation',
      'Up to 15 keywords tracked',
      'Monthly Google Business Profile posting',
      '2 blog articles per month',
      'Active local link building & outreach',
      'Quarterly technical SEO audit',
      'AI search (GEO) foundations: schema & FAQ',
      'Phone support',
    ],
  },
  {
    name: 'Authority',
    blurb: 'Become the obvious choice in your market',
    price: 'From $2,950',
    period: '/month',
    note: '+ one-off setup fee · Scoped after a short call',
    featured: false,
    features: [
      'Everything in Momentum',
      '22+ keywords tracked',
      'Full local pack strategy',
      '4 articles/month + digital PR & guest posts',
      'Advanced link acquisition campaign',
      'Ongoing (not quarterly) technical SEO',
      'Full-site AI search (GEO) optimisation',
      'Monthly strategy call, dedicated contact',
    ],
  },
];
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">SEO Pricing</p>
    <h2 class="mt-2 font-display text-3xl font-bold text-slate-900 sm:text-4xl">
      Local SEO & AI search visibility, priced to compete
    </h2>
    <p class="mt-4 text-sm text-slate-500">
      A straight monthly retainer for ongoing SEO work, plus a one-off setup fee — no 12-month
      lock-in. Website design is priced separately as its own project; see{' '}
      <a href="/pricing/#website-design" class="font-semibold text-brand-600 hover:underline">website design pricing below</a>.
    </p>
  </div>

  <!-- The dark "selected" treatment follows whichever card was last clicked (Momentum by default). -->
  <div data-tier-group class="mt-14 grid gap-8 lg:grid-cols-3">
    {
      tiers.map((tier) => (
        <div
          data-tier-card
          data-selected={String(tier.featured)}
          class="group/tier flex cursor-pointer flex-col rounded-3xl border border-slate-100 bg-white p-8 shadow-sm transition-all duration-300 hover:shadow-lg data-[selected=true]:border-brand-600 data-[selected=true]:bg-brand-900 data-[selected=true]:shadow-xl"
        >
          {tier.featured && (
            <span class="mb-4 inline-flex w-fit items-center rounded-full bg-accent-400 px-3 py-1 text-xs font-semibold text-brand-950">
              Most popular
            </span>
          )}
          <h3 class="font-display text-xl font-bold text-slate-900 transition-colors duration-300 group-data-[selected=true]/tier:text-white">
            {tier.name}
          </h3>
          <p class="mt-1 text-sm text-slate-500 transition-colors duration-300 group-data-[selected=true]/tier:text-brand-100">{tier.blurb}</p>

          <div class="mt-6 flex items-baseline gap-1">
            <span class="font-display text-4xl font-extrabold text-slate-900 transition-colors duration-300 group-data-[selected=true]/tier:text-white">
              {tier.price}
            </span>
            <span class="text-sm text-slate-400 transition-colors duration-300 group-data-[selected=true]/tier:text-brand-200">{tier.period}</span>
          </div>
          <p class="mt-1 text-xs text-slate-400 transition-colors duration-300 group-data-[selected=true]/tier:text-brand-200">{tier.note}</p>

          <ul class="mt-6 flex-1 space-y-3">
            {tier.features.map((f) => (
              <li class="flex items-start gap-2.5 text-sm">
                <Icon
                  name="lucide:check"
                  class="mt-0.5 h-4 w-4 shrink-0 text-accent-600 transition-colors duration-300 group-data-[selected=true]/tier:text-accent-300"
                />
                <span class="text-slate-600 transition-colors duration-300 group-data-[selected=true]/tier:text-brand-50">{f}</span>
              </li>
            ))}
          </ul>

          <a
            href="/contact/"
            class="mt-8 inline-flex items-center justify-center rounded-full bg-brand-600 px-5 py-3 text-sm font-semibold text-white transition-colors duration-300 hover:bg-brand-700 group-data-[selected=true]/tier:bg-accent-400 group-data-[selected=true]/tier:text-brand-950 group-data-[selected=true]/tier:hover:bg-accent-300"
          >
            Get My Free Audit
          </a>
        </div>
      ))
    }
  </div>

  <p class="mt-8 text-center text-xs text-slate-400">
    All prices exclude GST. Offers are intended for businesses (B2B) engaging Kwantum's services.
  </p>
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-tier-group]').forEach((group) => {
    const cards = group.querySelectorAll<HTMLElement>('[data-tier-card]');
    const select = (chosen: HTMLElement) => {
      cards.forEach((card) => (card.dataset.selected = String(card === chosen)));
    };
    cards.forEach((card) => {
      card.addEventListener('click', () => select(card));
      // Keyboard users tabbing onto a card's button get the same highlight.
      card.addEventListener('focusin', () => select(card));
    });
  });
</script>
