---
import { Icon } from 'astro-icon/components';

const channels = [
  {
    label: 'Google Maps',
    heading: 'Show up in the map pack',
    description:
      'Your Google Business Profile, fully optimised — categories, photos, posts and service areas set up properly so nearby customers find you first.',
    href: '/services/local-seo/',
  },
  {
    label: 'Google Search',
    heading: 'Rank for the searches that matter',
    description:
      'On-page SEO built around the exact suburb-and-service phrases your customers actually type — not generic keywords no one searches.',
    href: '/services/local-seo/',
  },
  {
    label: 'AI Assistants',
    heading: 'Get recommended by AI',
    description:
      "Structured data and answer-ready content so ChatGPT, Gemini and Google's AI Overviews understand your business and recommend it.",
    href: '/services/ai-search-visibility/',
  },
];
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">How it works</p>
    <h2 class="mt-2 font-display text-3xl font-bold text-slate-900 sm:text-4xl">
      Three places your next customer looks
    </h2>
    <p class="mt-4 text-sm text-slate-500">
      We don't sell a generic "process." We work on the three specific places local customers
      actually go before they call you.
    </p>
  </div>

  <div class="mt-14 grid gap-8 lg:grid-cols-3">
    <!-- Google Maps mock -->
    <div class="flex flex-col rounded-3xl border border-slate-100 bg-white p-6 shadow-sm">
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <div class="flex items-center gap-3">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600">
            <Icon name="lucide:map-pin" class="h-4 w-4" />
          </span>
          <div class="min-w-0">
            <p class="truncate text-sm font-semibold text-slate-900">Your Business Name</p>
            <p class="text-xs text-slate-500">
              <span class="text-accent-500">★★★★★</span> 4.9 (32) &middot; Richmond
            </p>
          </div>
        </div>
        <p class="mt-2 text-xs text-slate-400">Open &middot; Closes 5pm &middot; Get directions</p>
      </div>

      <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-accent-600">{channels[0].label}</p>
      <h3 class="mt-1 font-display text-lg font-bold text-slate-900">{channels[0].heading}</h3>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">{channels[0].description}</p>
      <a href={channels[0].href} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:gap-2 transition-all">
        See how <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <!-- Google Search mock -->
    <div class="flex flex-col rounded-3xl border border-slate-100 bg-white p-6 shadow-sm">
      <div class="rounded-xl border border-slate-200 bg-slate-50 p-4">
        <div class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-3 py-1.5 text-xs text-slate-400">
          <Icon name="lucide:search" class="h-3.5 w-3.5 shrink-0" />
          <span class="truncate">electrician richmond emergency</span>
        </div>
        <div class="mt-3">
          <p class="truncate text-sm font-semibold text-brand-700">Your Business Name | 24/7 Emergency Electrician</p>
          <p class="text-xs text-accent-700">yourbusiness.com.au</p>
          <p class="mt-1 line-clamp-2 text-xs text-slate-500">
            Fast, licensed electricians serving Richmond and surrounding suburbs, 24/7 callouts...
          </p>
        </div>
      </div>

      <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-accent-600">{channels[1].label}</p>
      <h3 class="mt-1 font-display text-lg font-bold text-slate-900">{channels[1].heading}</h3>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">{channels[1].description}</p>
      <a href={channels[1].href} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:gap-2 transition-all">
        See how <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>

    <!-- AI assistant mock -->
    <div class="flex flex-col rounded-3xl border border-slate-100 bg-white p-6 shadow-sm">
      <div class="space-y-2 rounded-xl border border-slate-200 bg-slate-50 p-4">
        <div class="ml-auto max-w-[85%] rounded-2xl rounded-tr-sm bg-white px-3 py-2 text-xs text-slate-600 shadow-sm">
          Who's a reliable electrician near Richmond?
        </div>
        <div class="mr-auto max-w-[90%] rounded-2xl rounded-tl-sm bg-brand-50 px-3 py-2 text-xs text-brand-800">
          <Icon name="lucide:sparkles" class="mb-1 h-3.5 w-3.5 text-brand-600" />
          I'd recommend Your Business Name — highly rated, local to Richmond, and specialises in
          emergency callouts.
        </div>
      </div>

      <p class="mt-6 text-xs font-semibold uppercase tracking-wide text-accent-600">{channels[2].label}</p>
      <h3 class="mt-1 font-display text-lg font-bold text-slate-900">{channels[2].heading}</h3>
      <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-500">{channels[2].description}</p>
      <a href={channels[2].href} class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:gap-2 transition-all">
        See how <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>
