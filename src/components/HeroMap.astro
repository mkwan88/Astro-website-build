---
// Animated "local map" hero art: roads draw in, signal ripples from your pin, other businesses
// bob, suburb tags float, and a search bubble types local searches (your pin hops each time).
// Flat shapes only, no fake results. Decorative, so hidden from screen readers. On each visit the
// tags and searches are drawn at random from suburbs around Australia (src/lib/au-suburbs.ts); the
// props are only the first frame before the script runs.
interface Props {
  suburbs?: [string, string, string];
  queries?: string[];
}

const {
  suburbs = ['Moonee Ponds', 'Ascot Vale', 'Essendon'],
  queries = ['plumber near me', 'cafe Moonee Ponds', 'electrician Essendon', 'dentist Ascot Vale', 'accountant near me'],
} = Astro.props;
---

<div class="hero-art motion-pop relative mx-auto aspect-square w-full max-w-[520px]" style="--d:150ms" aria-hidden="true" data-queries={JSON.stringify(queries)}>
  <svg viewBox="0 0 100 100" class="motion-spin absolute -right-2 -top-4 h-20 w-20 text-coral sm:-right-8 sm:-top-8 sm:h-28 sm:w-28">
    <circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" stroke-width="8" stroke-dasharray="14 10" />
  </svg>
  <div class="absolute inset-0 rounded-[3rem] bg-indigo"></div>
  <svg viewBox="0 0 520 520" class="absolute inset-0 h-full w-full overflow-hidden rounded-[3rem]">
    <g stroke="#6D66F0" stroke-width="18" stroke-linecap="round" fill="none">
      <path class="road" style="--d:200ms" pathLength="1" d="M-20 150 C120 130 220 190 540 120" />
      <path class="road" style="--d:350ms" pathLength="1" d="M-20 360 C150 330 300 400 540 330" />
      <path class="road" style="--d:500ms" pathLength="1" d="M150 -20 C170 160 120 320 190 540" />
      <path class="road" style="--d:650ms" pathLength="1" d="M360 -20 C330 170 400 330 350 540" />
    </g>
    <g fill="none" stroke="#FFCB47" stroke-width="8">
      <circle class="ripple" style="--d:0s" cx="262" cy="250" r="150" />
      <circle class="ripple" style="--d:1.2s" cx="262" cy="250" r="150" />
      <circle class="ripple" style="--d:2.4s" cx="262" cy="250" r="150" />
    </g>
    <g fill="#A5B4FC">
      <circle class="pin-bob" style="--d:0s" cx="95" cy="95" r="14" />
      <circle class="pin-bob" style="--d:.8s" cx="430" cy="420" r="14" />
      <circle class="pin-bob" style="--d:1.6s" cx="440" cy="90" r="14" />
      <circle class="pin-bob" style="--d:2.4s" cx="90" cy="430" r="14" />
    </g>
    <g class="your-pin" data-pin>
      <path d="M262 160 C222 160 192 190 192 230 C192 282 262 340 262 340 C262 340 332 282 332 230 C332 190 302 160 262 160 Z" fill="#2DD4BF" />
      <circle cx="262" cy="228" r="26" fill="#1E1B4B" />
    </g>
  </svg>
  <span data-chip class="chip motion-float absolute left-[6%] top-[58%] bg-sun" style="--r:-6deg; --d:1.0s">{suburbs[0]}</span>
  <span data-chip class="chip motion-float absolute right-[4%] top-[14%] bg-white" style="--r:5deg; --d:1.2s">{suburbs[1]}</span>
  <span data-chip class="chip motion-float absolute bottom-[8%] right-[18%] bg-coral" style="--r:-3deg; --d:1.4s">{suburbs[2]}</span>
  <span class="chip motion-float absolute left-[8%] top-[7%] bg-teal" style="--r:4deg; --d:0.8s">
    <span class="mr-1.5 opacity-60">🔍</span><span data-typer>{queries[0]}</span><span class="caret">|</span>
  </span>
</div>

<style>
  .road { stroke-dasharray: 1; stroke-dashoffset: 1; animation: draw 1.1s ease-out var(--d) forwards; }
  .ripple { transform-box: fill-box; transform-origin: center; opacity: 0; animation: ripple 3.6s ease-out var(--d) infinite; }
  .pin-bob { transform-box: fill-box; transform-origin: center; animation: pin-bob 3.2s ease-in-out var(--d) infinite; }
  .your-pin { transform-box: fill-box; transform-origin: 50% 100%; animation: drop 0.9s cubic-bezier(.34,1.56,.64,1) 0.6s both, pin-hover 3.5s ease-in-out 1.5s infinite; }
  .your-pin.found { animation: found 0.6s cubic-bezier(.34,1.56,.64,1), pin-hover 3.5s ease-in-out 0.6s infinite; }
  .caret { margin-left: 1px; animation: blink 1s steps(1) infinite; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes ripple { 0% { transform: scale(0.35); opacity: 0.9; } 100% { transform: scale(1.25); opacity: 0; } }
  @keyframes pin-bob { 50% { transform: translateY(-8px) scale(1.15); } }
  @keyframes drop { from { opacity: 0; transform: translateY(-160px); } }
  @keyframes pin-hover { 50% { transform: translateY(-10px); } }
  @keyframes found { 40% { transform: translateY(-26px) scale(1.12); } }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) {
    .road { stroke-dashoffset: 0; }
    .ripple { opacity: 0.5; }
  }
</style>

<script>
  import { AU_SUBURBS, SEARCH_TERMS } from '../lib/au-suburbs';

  const pick = <T,>(list: T[]) => list[Math.floor(Math.random() * list.length)];
  const placeName = (s: string) => s.replace(/\s+[A-Z]{2,3}$/, ''); // "Fremantle WA" -> "Fremantle"

  document.querySelectorAll<HTMLElement>('.hero-art[data-queries]').forEach((art) => {
    const typer = art.querySelector<HTMLElement>('[data-typer]');
    const pin = art.querySelector<SVGGElement>('[data-pin]');
    const chips = [...art.querySelectorAll<HTMLElement>('[data-chip]')];

    // Random suburbs from around Australia for the floating tags.
    const start = [...AU_SUBURBS].sort(() => Math.random() - 0.5);
    chips.forEach((chip, i) => (chip.textContent = placeName(start[i])));

    if (!typer || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const nextQuery = () => {
      const suburb = placeName(pick(AU_SUBURBS));
      return { suburb, text: Math.random() < 0.2 ? `${pick(SEARCH_TERMS)} near me` : `${pick(SEARCH_TERMS)} ${suburb}` };
    };
    const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const popIn = (el: HTMLElement) => el.animate([{ scale: '0.6', opacity: 0 }, { scale: '1', opacity: 1 }], { duration: 450, easing: 'cubic-bezier(.34,1.56,.64,1)' });

    (async () => {
      await sleep(2200);
      for (let n = 0; ; n++) {
        const q = nextQuery();
        for (let i = typer.textContent!.length; i >= 0; i--) { typer.textContent = typer.textContent!.slice(0, i); await sleep(35); }
        for (let i = 1; i <= q.text.length; i++) { typer.textContent = q.text.slice(0, i); await sleep(70); }
        if (pin) { pin.classList.remove('found'); void pin.getBoundingClientRect(); pin.classList.add('found'); }
        // The suburb just searched pops onto the map as one of the tags.
        if (!q.text.endsWith('near me') && chips.length) {
          const chip = chips[n % chips.length];
          chip.textContent = q.suburb;
          popIn(chip);
        }
        await sleep(2400);
      }
    })();
  });
</script>
