---
interface Props {
  variant?: 'full' | 'icon';
  class?: string;
  markClass?: string;
  wordmarkClass?: string;
}

const { variant = 'full', class: className = '', markClass = '', wordmarkClass = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  <svg
    viewBox="0 0 40 40"
    class:list={['h-9 w-9 shrink-0', markClass]}
    role="img"
    aria-label="Kwantum icon mark"
  >
    <rect width="40" height="40" rx="10" class="fill-brand-600" />
    <rect x="10" y="8" width="5" height="24" rx="1.5" fill="white" />
    <path d="M17 20 L30 8" stroke="white" stroke-width="5" stroke-linecap="round" />
    <path d="M17 20 L30 32" stroke="white" stroke-width="5" stroke-linecap="round" />
    <circle cx="33" cy="8" r="5" class="fill-accent-400" />
  </svg>
  {
    variant === 'full' && (
      <span
        class:list={[
          'font-display text-xl font-extrabold tracking-tight text-brand-900',
          wordmarkClass,
        ]}
      >
        Kwantum
      </span>
    )
  }
</span>
