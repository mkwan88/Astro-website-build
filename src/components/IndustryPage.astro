---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import PricingTable from './PricingTable.astro';
import Faq from './Faq.astro';
import CtaSection from './CtaSection.astro';
import { SITE } from '../lib/site';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../lib/schema';

interface Item {
  title: string;
  description: string;
}

interface Props {
  metaTitle: string;
  metaDescription: string;
  path: string;
  serviceName: string;
  crumbs: { name: string; href: string }[];
  h1: string;
  intro: string[];
  demand: { heading: string; paragraphs: string[] };
  problems: { heading: string; items: string[] };
  whatWeDo: { heading: string; items: Item[] };
  split: { heading: string; intro?: string; items: Item[] };
  faq: { question: string; answer: string }[];
  related: { label: string; href: string }[];
}

const {
  metaTitle,
  metaDescription,
  path,
  serviceName,
  crumbs,
  h1,
  intro,
  demand,
  problems,
  whatWeDo,
  split,
  faq,
  related,
} = Astro.props;

const pageUrl = `${SITE.url}${path}`;

const phases = [
  {
    title: 'Phase 1: Free audit',
    description:
      'We look at your Google profile, your website and how you show up in Maps compared with nearby competitors. You get a straight read on what’s working, what’s costing you jobs and what to fix first. No obligation.',
  },
  {
    title: 'Phase 2: Setup',
    description:
      'A one-off job at the start. We overhaul your profile, link and track your website, put your review system in place and clean up your directory listings. We also record where you rank today, so there’s a baseline to measure against.',
  },
  {
    title: 'Phase 3: Ongoing',
    description:
      'Each month we keep the profile current, post updates, handle review requests and replies, and build out the pages and content that win local searches. You get a plain-English monthly report: rankings, visibility and enquiries.',
  },
];

const needs = [
  'Manager access to your Google Business Profile (we show you how in two minutes)',
  'A 20-minute kick-off call',
  '10 to 20 recent photos of your team, vehicles and completed jobs',
];
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  schema={[
    serviceSchema({ name: serviceName, description: metaDescription, url: pageUrl }),
    breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` }))),
    faqSchema(faq),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="bg-gradient-to-b from-brand-50/60 to-white">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl font-extrabold text-slate-900 sm:text-5xl">{h1}</h1>
      {
        intro.map((p) => (
          <p class="mt-5 text-lg leading-relaxed text-slate-600">{p}</p>
        ))
      }
      <a
        href="/contact/"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 hover:bg-brand-700"
      >
        Get My Free Audit
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
      <p class="mt-3 text-sm text-slate-500">Free, no obligation. A straight read on what’s working and what isn’t.</p>
    </div>
  </section>

  <!-- Demand -->
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">{demand.heading}</h2>
    {demand.paragraphs.map((p) => <p class="mt-4 leading-relaxed text-slate-600">{p}</p>)}
  </section>

  <!-- Problems -->
  <section class="bg-slate-50 py-14">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">{problems.heading}</h2>
      <ul class="mt-6 space-y-3">
        {
          problems.items.map((item) => (
            <li class="flex items-start gap-3 text-slate-600">
              <Icon name="lucide:check-circle-2" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- What we do -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">{whatWeDo.heading}</h2>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">
      {
        whatWeDo.items.map((item) => (
          <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <Icon name="lucide:check-circle-2" class="h-6 w-6 text-accent-600" />
            <h3 class="mt-3 font-display font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">{item.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Industry-specific split -->
  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">{split.heading}</h2>
      {split.intro && <p class="mt-3 max-w-2xl text-slate-600">{split.intro}</p>}
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          split.items.map((item) => (
            <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
              <h3 class="font-display font-semibold text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Phases -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">How we work together</h2>
    <p class="mt-3 max-w-2xl text-slate-600">We work in three phases. You always know what’s happening and what’s next.</p>
    <ol class="mt-8 grid gap-6 md:grid-cols-3">
      {
        phases.map((phase, i) => (
          <li class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <span class="font-display text-3xl font-extrabold text-brand-100">{i + 1}</span>
            <h3 class="mt-2 font-display font-semibold text-slate-900">{phase.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">{phase.description}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 rounded-2xl border border-slate-100 bg-slate-50 p-6">
      <h3 class="font-display font-semibold text-slate-900">What you need to give us</h3>
      <ul class="mt-4 space-y-2">
        {
          needs.map((n) => (
            <li class="flex items-start gap-2 text-sm text-slate-600">
              <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600" />
              {n}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Plans -->
  <section class="bg-slate-50 pt-4">
    <div class="mx-auto max-w-3xl px-4 pt-12 text-center sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">Plans and pricing</h2>
      <p class="mt-3 text-slate-600">
        A straight monthly price, plus a one-off setup fee, with no lock-in contract. We guarantee the work, not
        rankings. Nobody can honestly promise a Google position, and you should be wary of anyone who does.
      </p>
    </div>
    <PricingTable />
    <p class="mx-auto max-w-3xl px-4 pb-16 text-center text-sm text-slate-600 sm:px-6 lg:px-8">
      Want to know more about the profile side?
      <a href="/services/google-business-profile-optimization/" class="font-semibold text-brand-600 hover:underline">
        See Google Business Profile optimisation
      </a>.
    </p>
  </section>

  <Faq items={faq} />

  <!-- Related -->
  <section class="mx-auto max-w-3xl px-4 pb-14 sm:px-6 lg:px-8">
    <h2 class="font-display text-xl font-bold text-slate-900">Related pages</h2>
    <div class="mt-4 flex flex-wrap gap-3">
      {
        related.map((r) => (
          <a
            href={r.href}
            class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600"
          >
            {r.label}
          </a>
        ))
      }
    </div>
  </section>

  <CtaSection
    heading="Ready to get found?"
    body="Get a free visibility audit: where you show up on Google today, what’s costing you jobs and exactly what to fix."
  />
</BaseLayout>
