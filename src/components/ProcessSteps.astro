---
const steps = [
  {
    number: '1',
    title: 'Free Visibility Audit',
    description:
      "We review your current site and search presence and give it to you straight — what's working, what's costing you leads, no jargon.",
  },
  {
    number: '2',
    title: 'We Build & Write',
    description:
      'A fast, modern site with the copy done for you. You supply the basics, we handle the rest.',
  },
  {
    number: '3',
    title: 'Get Found',
    description:
      'Local SEO and AI-search optimisation so you show up on Google and get recommended by AI assistants.',
  },
  {
    number: '4',
    title: 'Ongoing Support',
    description:
      "We don't disappear after launch. Your site stays secure, current, and fast — one message away.",
  },
];
---

<section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl text-center">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">How we work</p>
    <h2 class="mt-2 font-display text-3xl font-bold text-slate-900 sm:text-4xl">
      Four steps to a site that works
    </h2>
  </div>

  <div class="mt-14 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {
      steps.map((step) => (
        <div class="relative rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
          <span class="font-display text-4xl font-extrabold text-brand-100">{step.number}</span>
          <h3 class="mt-3 font-display text-lg font-semibold text-slate-900">{step.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-500">{step.description}</p>
        </div>
      ))
    }
  </div>
</section>
