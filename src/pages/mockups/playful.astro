---
// Design mock-up A ("Playful local"). Preview only: noindex, kept off the sitemap, and lives on the
// site-refresh branch. Delete before merging.
import '@fontsource-variable/bricolage-grotesque';
import '../../styles/global.css';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import markPortrait from '../../assets/team/mark-kwan-portrait.jpg';
import { SITE } from '../../lib/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const suburbs = ['Ascot Vale', 'Moonee Ponds', 'Essendon', 'Flemington', 'Kensington', 'Maribyrnong', 'Footscray', 'Brunswick', 'North Melbourne', 'Yarraville', 'Sunshine', 'Airport West'];

const services = [
  {
    title: 'Show up on the map.',
    body: 'Your Google Business Profile set up properly: categories, services, suburbs, photos and a simple way to win more reviews.',
    link: '/services/local-seo/',
    label: 'Local SEO',
    bg: 'bg-[#FFCB47]',
    dot: 'bg-[#1E1B4B] text-[#FFCB47]',
  },
  {
    title: 'Win the search.',
    body: 'Pages built around what people in your area actually type, like “emergency plumber Moonee Ponds”, on a fast website you own.',
    link: '/services/website-design/',
    label: 'Websites',
    bg: 'bg-[#2DD4BF]',
    dot: 'bg-[#1E1B4B] text-[#2DD4BF]',
  },
  {
    title: 'Get named by AI.',
    body: 'Clear, structured information so ChatGPT, Gemini and Google’s AI answers can understand your business and mention it.',
    link: '/services/ai-search-visibility/',
    label: 'AI search',
    bg: 'bg-[#FF8A65]',
    dot: 'bg-[#1E1B4B] text-[#FF8A65]',
  },
];

const auditItems = [
  'Your Google Business Profile, field by field',
  'Where you show up in Maps for your main suburbs',
  'How your website loads on a phone',
  'Which searches send you customers, and which don’t',
  'Whether AI assistants mention you',
  'The three fixes that would make the biggest difference',
];

const dateFormatter = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Mock-up A: Playful local | Kwantum</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-[#FBF6EC] text-[#1E1B4B] antialiased">
    <div class="sticky top-0 z-50 bg-[#1E1B4B] py-2 text-center text-xs font-semibold text-white">
      Design mock-up A · Playful local · not live
    </div>

    <!-- Nav -->
    <header class="mx-auto flex max-w-7xl items-center justify-between px-5 py-6 sm:px-8">
      <a href="/mockups/playful/" class="flex items-center gap-2.5">
        <svg viewBox="0 0 40 40" class="h-10 w-10" aria-hidden="true">
          <rect width="40" height="40" rx="10" fill="#4F46E5" />
          <rect x="10" y="8" width="5" height="24" rx="1.5" fill="white" />
          <path d="M17 20 L30 8" stroke="white" stroke-width="5" stroke-linecap="round" />
          <path d="M17 20 L30 32" stroke="white" stroke-width="5" stroke-linecap="round" />
          <circle cx="33" cy="8" r="5" fill="#2DD4BF" />
        </svg>
        <span class="display text-2xl font-extrabold tracking-tight">Kwantum</span>
      </a>
      <nav class="hidden items-center gap-8 text-[15px] font-medium md:flex">
        <a href="#services" class="hover:underline decoration-[#2DD4BF] decoration-4 underline-offset-8">What I do</a>
        <a href="#audit" class="hover:underline decoration-[#2DD4BF] decoration-4 underline-offset-8">Free audit</a>
        <a href="/pricing/" class="hover:underline decoration-[#2DD4BF] decoration-4 underline-offset-8">Pricing</a>
        <a href="#blog" class="hover:underline decoration-[#2DD4BF] decoration-4 underline-offset-8">Blog</a>
      </nav>
      <a href={`tel:${SITE.phone}`} class="pill hidden bg-white sm:inline-flex">
        <span>Call Mark</span>
        <span class="pill-dot bg-[#2DD4BF]">→</span>
      </a>
    </header>

    <!-- Hero -->
    <section class="mx-auto grid max-w-7xl items-center gap-12 px-5 pb-20 pt-6 sm:px-8 lg:grid-cols-[1.1fr_1fr] lg:pt-12">
      <div>
        <p class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold shadow-sm">
          <span class="h-2.5 w-2.5 rounded-full bg-[#2DD4BF]"></span>
          Local SEO from Ascot Vale, Melbourne
        </p>
        <h1 class="display mt-7 text-[3.25rem] font-extrabold leading-[0.98] tracking-tight sm:text-7xl">
          Be the first call in your suburb.
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-[#1E1B4B]/75">
          I help Melbourne small businesses show up on Google, in Google Maps and in AI answers, so
          the people already searching for what you do find you first.
        </p>
        <div class="mt-9 flex flex-wrap items-center gap-4">
          <a href="/contact/" class="pill pill-lg bg-[#1E1B4B] text-white">
            <span>Get a free audit</span>
            <span class="pill-dot bg-[#FFCB47] text-[#1E1B4B]">→</span>
          </a>
          <a href="#audit" class="text-[15px] font-semibold underline decoration-[#2DD4BF] decoration-4 underline-offset-[6px]">What’s in the audit?</a>
        </div>
      </div>

      <!-- Hero art: a stylised local map. Flat shapes, no fake results. -->
      <div class="relative mx-auto aspect-square w-full max-w-[520px]" aria-hidden="true">
        <div class="absolute inset-0 rounded-[3rem] bg-[#4F46E5]"></div>
        <svg viewBox="0 0 520 520" class="absolute inset-0 h-full w-full">
          <g stroke="#6D66F0" stroke-width="18" stroke-linecap="round" fill="none">
            <path d="M-20 150 C120 130 220 190 540 120" />
            <path d="M-20 360 C150 330 300 400 540 330" />
            <path d="M150 -20 C170 160 120 320 190 540" />
            <path d="M360 -20 C330 170 400 330 350 540" />
          </g>
          <circle cx="262" cy="250" r="150" fill="none" stroke="#FFCB47" stroke-width="10" opacity="0.9" />
          <circle cx="262" cy="250" r="95" fill="none" stroke="#FFCB47" stroke-width="10" opacity="0.5" />
          <!-- other pins -->
          <g fill="#A5B4FC">
            <circle cx="95" cy="95" r="14" />
            <circle cx="430" cy="420" r="14" />
            <circle cx="440" cy="90" r="14" />
            <circle cx="90" cy="430" r="14" />
          </g>
          <!-- your pin -->
          <g class="bob">
            <path d="M262 160 C222 160 192 190 192 230 C192 282 262 340 262 340 C262 340 332 282 332 230 C332 190 302 160 262 160 Z" fill="#2DD4BF" />
            <circle cx="262" cy="228" r="26" fill="#1E1B4B" />
          </g>
        </svg>
        <span class="chip left-[6%] top-[58%] rotate-[-6deg] bg-[#FFCB47]">Moonee Ponds</span>
        <span class="chip right-[4%] top-[14%] rotate-[5deg] bg-white">Ascot Vale</span>
        <span class="chip bottom-[8%] right-[18%] rotate-[-3deg] bg-[#FF8A65]">Essendon</span>
        <span class="chip left-[10%] top-[8%] rotate-[4deg] bg-[#2DD4BF]">“plumber near me”</span>
      </div>
    </section>

    <!-- Suburb marquee -->
    <div class="overflow-hidden border-y-2 border-[#1E1B4B] bg-[#FFCB47] py-4" aria-label="Suburbs I work in">
      <div class="marquee flex w-max gap-10 whitespace-nowrap display text-2xl font-bold">
        {[...suburbs, ...suburbs].map((s) => (
          <span class="flex items-center gap-10">{s}<span class="h-3 w-3 rounded-full bg-[#1E1B4B]"></span></span>
        ))}
      </div>
    </div>

    <!-- Services -->
    <section id="services" class="mx-auto max-w-7xl px-5 py-24 sm:px-8">
      <h2 class="display max-w-2xl text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
        Three places your next customer looks.
      </h2>
      <div class="mt-12 grid gap-6 lg:grid-cols-3">
        {services.map((s, i) => (
          <a href={s.link} class={`card group flex min-h-[340px] flex-col justify-between rounded-[2rem] p-8 ${s.bg}`} style={`--tilt:${[-1.2, 0.8, -0.6][i]}deg`}>
            <div>
              <p class="text-sm font-bold uppercase tracking-wider">{s.label}</p>
              <h3 class="display mt-4 text-3xl font-extrabold leading-tight">{s.title}</h3>
              <p class="mt-4 leading-relaxed">{s.body}</p>
            </div>
            <span class={`mt-8 flex h-12 w-12 items-center justify-center rounded-full text-xl font-bold transition-transform group-hover:translate-x-1 ${s.dot}`}>→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Founder -->
    <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8">
      <div class="grid items-center gap-12 rounded-[2.5rem] bg-white p-8 sm:p-12 lg:grid-cols-[auto_1fr] lg:p-16">
        <div class="relative mx-auto w-56 sm:w-64">
          <div class="absolute -inset-4 rotate-6 rounded-[2.5rem] bg-[#2DD4BF]"></div>
          <Image src={markPortrait} alt="Mark Kwan, founder of Kwantum" width={424} height={424} class="relative aspect-square w-full rounded-[2rem] object-cover" />
          <span class="chip -bottom-5 -right-6 rotate-[-4deg] bg-[#FFCB47]">That’s me 👋</span>
        </div>
        <div>
          <h2 class="display text-4xl font-extrabold tracking-tight sm:text-5xl">Hi, I’m Mark.</h2>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[#1E1B4B]/80">
            I started Kwantum to give local businesses the help I’d want myself: plain English, a
            phone that gets answered, and someone who sticks around after the website goes live.
            You deal with me from the first audit to every monthly report.
          </p>
          <div class="mt-8 flex flex-wrap gap-3 text-sm font-semibold">
            <span class="rounded-full border-2 border-[#1E1B4B] px-4 py-2">Based in Ascot Vale</span>
            <span class="rounded-full border-2 border-[#1E1B4B] px-4 py-2">No lock-in contracts</span>
            <span class="rounded-full border-2 border-[#1E1B4B] px-4 py-2">Call me: {SITE.phoneDisplay}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Audit -->
    <section id="audit" class="bg-[#4F46E5] py-24 text-white">
      <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 sm:px-8 lg:grid-cols-2">
        <div>
          <h2 class="display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
            The free audit, and what you actually get.
          </h2>
          <p class="mt-6 max-w-lg text-lg leading-relaxed text-white/80">
            Not a sales call dressed up as a report. I look at how you show up today and send back
            a plain-English write-up you can act on, whether or not you hire me.
          </p>
          <a href="/contact/" class="pill pill-lg mt-9 bg-[#FFCB47] text-[#1E1B4B]">
            <span>Request my audit</span>
            <span class="pill-dot bg-[#1E1B4B] text-[#FFCB47]">→</span>
          </a>
        </div>
        <div class="relative">
          <div class="absolute -right-3 -top-3 z-10 flex h-24 w-24 rotate-12 items-center justify-center rounded-full bg-[#FF8A65] display text-lg font-extrabold text-[#1E1B4B]">Free</div>
          <div class="rotate-[-1.5deg] rounded-[2rem] bg-[#FBF6EC] p-8 text-[#1E1B4B] shadow-2xl sm:p-10">
            <p class="text-sm font-bold uppercase tracking-wider text-[#4F46E5]">Visibility audit · what’s covered</p>
            <ul class="mt-6 space-y-4">
              {auditItems.map((item, i) => (
                <li class="flex items-start gap-4">
                  <span class="display flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-[#2DD4BF] text-sm font-extrabold">{i + 1}</span>
                  <span class="pt-1 font-medium">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Pricing strip -->
    <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8">
      <div class="grid gap-6 md:grid-cols-2">
        <div class="rounded-[2rem] border-2 border-[#1E1B4B] p-8 sm:p-10">
          <p class="text-sm font-bold uppercase tracking-wider">Ongoing SEO</p>
          <p class="display mt-3 text-5xl font-extrabold">From $1,000<span class="text-2xl">/month</span></p>
          <p class="mt-3 text-[#1E1B4B]/70">Month to month. No lock-in. Prices exclude GST.</p>
        </div>
        <div class="rounded-[2rem] border-2 border-[#1E1B4B] p-8 sm:p-10">
          <p class="text-sm font-bold uppercase tracking-wider">New website</p>
          <p class="display mt-3 text-5xl font-extrabold">From $1,490</p>
          <p class="mt-3 text-[#1E1B4B]/70">One-off. Copywriting included. Yours once it launches.</p>
        </div>
      </div>
      <a href="/pricing/" class="mt-8 inline-block font-semibold underline decoration-[#2DD4BF] decoration-4 underline-offset-[6px]">See full pricing</a>
    </section>

    <!-- Blog -->
    <section id="blog" class="mx-auto max-w-7xl px-5 pb-24 sm:px-8">
      <h2 class="display text-4xl font-extrabold tracking-tight sm:text-5xl">Straight answers, written down.</h2>
      <div class="mt-10 grid gap-6 md:grid-cols-3">
        {posts.map((p) => (
          <a href={`/blog/${p.id}/`} class="group overflow-hidden rounded-[2rem] bg-white transition-transform hover:-translate-y-1">
            <Image src={p.data.heroImage} alt={p.data.heroImageAlt} width={800} height={450} class="aspect-video w-full object-cover" />
            <div class="p-7">
              <p class="text-xs font-semibold uppercase tracking-wider text-[#1E1B4B]/50">{dateFormatter.format(p.data.publishDate)}</p>
              <h3 class="display mt-2 text-xl font-bold leading-snug group-hover:underline decoration-[#2DD4BF] decoration-4 underline-offset-4">{p.data.title}</h3>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Final CTA -->
    <section class="px-5 pb-10 sm:px-8">
      <div class="relative mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-[#FFCB47] px-8 py-20 text-center sm:px-16">
        <div class="absolute -left-16 -top-16 h-56 w-56 rounded-full border-[14px] border-[#1E1B4B]/10"></div>
        <div class="absolute -bottom-20 -right-10 h-72 w-72 rounded-full bg-[#2DD4BF]/40"></div>
        <h2 class="display relative text-4xl font-extrabold tracking-tight sm:text-6xl">Let’s see where you stand.</h2>
        <p class="relative mx-auto mt-5 max-w-xl text-lg">Send me your website or business name. I’ll come back with what’s working, what isn’t, and what I’d fix first.</p>
        <a href="/contact/" class="pill pill-lg relative mt-9 bg-[#1E1B4B] text-white">
          <span>Get a free audit</span>
          <span class="pill-dot bg-[#2DD4BF] text-[#1E1B4B]">→</span>
        </a>
      </div>
    </section>

    <footer class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-4 px-5 py-10 text-sm text-[#1E1B4B]/60 sm:px-8">
      <span>© Kwantum · Ascot Vale, Melbourne</span>
      <span>{SITE.email} · {SITE.phoneDisplay}</span>
    </footer>

    <style>
      body { font-family: 'Inter Variable', system-ui, sans-serif; }
      h1, h2, h3 { color: inherit; }
      .display { font-family: 'Bricolage Grotesque Variable', 'Inter Variable', sans-serif; }
      .pill {
        display: inline-flex; align-items: center; gap: 0.9rem;
        border-radius: 999px; padding: 0.4rem 0.45rem 0.4rem 1.25rem;
        font-weight: 600; font-size: 15px; box-shadow: 0 1px 2px rgb(30 27 75 / 0.08);
        transition: transform 0.2s ease;
      }
      .pill:hover { transform: translateY(-2px); }
      .pill-lg { padding: 0.55rem 0.55rem 0.55rem 1.6rem; font-size: 16px; }
      .pill-dot {
        display: inline-flex; height: 2.4rem; width: 2.4rem; align-items: center; justify-content: center;
        border-radius: 999px; font-weight: 700; transition: transform 0.2s ease;
      }
      .pill:hover .pill-dot { transform: translateX(3px); }
      .chip {
        position: absolute; border-radius: 999px; padding: 0.55rem 1rem;
        font-weight: 700; font-size: 14px; color: #1E1B4B; box-shadow: 0 6px 0 rgb(30 27 75 / 0.18);
        white-space: nowrap;
      }
      .card { transform: rotate(var(--tilt)); transition: transform 0.25s ease; }
      .card:hover { transform: rotate(0deg) translateY(-4px); }
      .marquee { animation: marquee 40s linear infinite; }
      .bob { animation: bob 3.5s ease-in-out infinite; }
      @keyframes marquee { to { transform: translateX(-50%); } }
      @keyframes bob { 50% { transform: translateY(-10px); } }
      @media (prefers-reduced-motion: reduce) {
        .marquee, .bob { animation: none; }
        .card, .card:hover { transform: none; }
      }
    </style>
  </body>
</html>
