---
// Design mock-up B ("Calm and confident"). Preview only: noindex, kept off the sitemap, and lives
// on the site-refresh branch. Delete before merging.
import '@fontsource-variable/fraunces';
import '../../styles/global.css';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import markPortrait from '../../assets/team/mark-kwan-portrait.jpg';
import { SITE } from '../../lib/site';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 4);

const services = [
  {
    n: '01',
    title: 'Google Maps and your Business Profile',
    body: 'Most local enquiries start in Maps. I set up your profile properly, keep it active, and build a steady flow of reviews.',
    link: '/services/local-seo/',
  },
  {
    n: '02',
    title: 'A website that earns its keep',
    body: 'Fast, clear pages for each service and suburb you cover, written for the way your customers actually search.',
    link: '/services/website-design/',
  },
  {
    n: '03',
    title: 'Answers from AI assistants',
    body: 'Structured, accurate information so ChatGPT, Gemini and Google’s AI answers can describe your business correctly.',
    link: '/services/ai-search-visibility/',
  },
];

const auditItems = [
  ['Google Business Profile', 'Every field checked against what Google uses to rank you'],
  ['Maps visibility', 'Where you appear for your main suburbs and services'],
  ['Website', 'Speed on a phone, page structure, and what’s missing'],
  ['Search', 'Which searches bring customers, and which competitors win'],
  ['AI answers', 'Whether ChatGPT and Google’s AI mention you'],
  ['Next steps', 'The three fixes that would make the biggest difference'],
];

const dateFormatter = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'short', year: 'numeric' });
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Mock-up B: Calm and confident | Kwantum</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body class="bg-[#F7F5F0] text-[#16142E] antialiased">
    <div class="sticky top-0 z-50 bg-[#16142E] py-2 text-center text-xs font-semibold text-white">
      Design mock-up B · Calm and confident · not live
    </div>

    <header class="mx-auto flex max-w-6xl items-center justify-between border-b border-[#16142E]/15 px-5 py-6 sm:px-8">
      <a href="/mockups/editorial/" class="flex items-center gap-2.5">
        <svg viewBox="0 0 40 40" class="h-9 w-9" aria-hidden="true">
          <rect width="40" height="40" rx="10" fill="#16142E" />
          <rect x="10" y="8" width="5" height="24" rx="1.5" fill="white" />
          <path d="M17 20 L30 8" stroke="white" stroke-width="5" stroke-linecap="round" />
          <path d="M17 20 L30 32" stroke="white" stroke-width="5" stroke-linecap="round" />
          <circle cx="33" cy="8" r="5" fill="#E07A4F" />
        </svg>
        <span class="serif text-2xl font-semibold">Kwantum</span>
      </a>
      <nav class="hidden items-center gap-8 text-[15px] md:flex">
        <a href="#services" class="hover:text-[#C2562D]">Services</a>
        <a href="#audit" class="hover:text-[#C2562D]">The audit</a>
        <a href="/pricing/" class="hover:text-[#C2562D]">Pricing</a>
        <a href="#writing" class="hover:text-[#C2562D]">Writing</a>
      </nav>
      <a href="/contact/" class="rounded-full bg-[#16142E] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#C2562D]">Free audit</a>
    </header>

    <!-- Hero -->
    <section class="mx-auto grid max-w-6xl gap-14 px-5 py-20 sm:px-8 lg:grid-cols-[1.4fr_1fr] lg:py-28">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#C2562D]">Local SEO · Ascot Vale, Melbourne</p>
        <h1 class="serif mt-6 text-5xl font-medium leading-[1.04] tracking-tight sm:text-7xl">
          Get found by the people <em class="text-[#C2562D]">already looking</em> for you.
        </h1>
        <p class="mt-8 max-w-xl text-lg leading-relaxed text-[#16142E]/75">
          I help Melbourne small businesses show up on Google, in Google Maps and in AI answers.
          Plain English, honest advice, and no lock-in contracts.
        </p>
        <div class="mt-10 flex flex-wrap items-center gap-6">
          <a href="/contact/" class="rounded-full bg-[#C2562D] px-7 py-4 font-semibold text-white hover:bg-[#16142E]">Get a free audit</a>
          <a href={`tel:${SITE.phone}`} class="font-semibold underline decoration-[#C2562D] decoration-2 underline-offset-4">Or call {SITE.phoneDisplay}</a>
        </div>
      </div>
      <aside class="self-end border-l-2 border-[#C2562D] pl-8">
        <Image src={markPortrait} alt="Mark Kwan, founder of Kwantum" width={424} height={424} class="h-24 w-24 rounded-full object-cover grayscale-[20%]" />
        <p class="serif mt-6 text-xl leading-relaxed">
          “Most local businesses don’t need a big agency. They need someone who knows their area,
          tells them the truth, and picks up the phone.”
        </p>
        <p class="mt-4 text-sm font-semibold">Mark Kwan, founder</p>
      </aside>
    </section>

    <!-- Services -->
    <section id="services" class="border-y border-[#16142E]/15 bg-white">
      <div class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
        <h2 class="serif max-w-2xl text-4xl font-medium leading-tight sm:text-5xl">Three places your next customer looks.</h2>
        <div class="mt-14 divide-y divide-[#16142E]/15 border-t border-[#16142E]/15">
          {services.map((s) => (
            <a href={s.link} class="group grid gap-4 py-10 md:grid-cols-[120px_1fr_1.2fr_40px] md:items-baseline">
              <span class="serif text-2xl text-[#C2562D]">{s.n}</span>
              <h3 class="serif text-2xl font-medium leading-snug group-hover:text-[#C2562D]">{s.title}</h3>
              <p class="leading-relaxed text-[#16142E]/70">{s.body}</p>
              <span class="hidden text-2xl transition-transform group-hover:translate-x-1 md:block">→</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Audit -->
    <section id="audit" class="mx-auto grid max-w-6xl gap-16 px-5 py-24 sm:px-8 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#C2562D]">The free audit</p>
        <h2 class="serif mt-4 text-4xl font-medium leading-tight sm:text-5xl">A written review you can act on, whether or not you hire me.</h2>
        <p class="mt-6 max-w-lg text-lg leading-relaxed text-[#16142E]/75">
          Send me your business name and website. I’ll look at how you show up today and come back
          with a plain-English write-up covering the six areas opposite.
        </p>
        <a href="/contact/" class="mt-9 inline-block rounded-full bg-[#16142E] px-7 py-4 font-semibold text-white hover:bg-[#C2562D]">Request my audit</a>
      </div>
      <div class="rounded-sm bg-white p-10 shadow-[0_30px_60px_-30px_rgb(22_20_46_/_0.35)]">
        <div class="flex items-baseline justify-between border-b border-[#16142E]/15 pb-5">
          <p class="serif text-2xl">Visibility audit</p>
          <p class="text-xs uppercase tracking-[0.18em] text-[#16142E]/50">What’s covered</p>
        </div>
        <dl class="divide-y divide-[#16142E]/10">
          {auditItems.map(([k, v], i) => (
            <div class="grid grid-cols-[2rem_1fr] gap-3 py-4">
              <dt class="serif text-[#C2562D]">{i + 1}.</dt>
              <dd><span class="font-semibold">{k}</span><span class="block text-sm text-[#16142E]/65">{v}</span></dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- Pricing -->
    <section class="bg-[#16142E] text-white">
      <div class="mx-auto grid max-w-6xl gap-12 px-5 py-20 sm:px-8 md:grid-cols-[1fr_1fr_1fr] md:items-end">
        <h2 class="serif text-4xl font-medium leading-tight">Prices on the page.</h2>
        <div class="border-t border-white/25 pt-5">
          <p class="text-sm uppercase tracking-[0.18em] text-white/60">Ongoing SEO</p>
          <p class="serif mt-2 text-4xl">From $1,000<span class="text-lg text-white/60"> / month</span></p>
          <p class="mt-2 text-sm text-white/60">Month to month, no lock-in</p>
        </div>
        <div class="border-t border-white/25 pt-5">
          <p class="text-sm uppercase tracking-[0.18em] text-white/60">New website</p>
          <p class="serif mt-2 text-4xl">From $1,490</p>
          <p class="mt-2 text-sm text-white/60">One-off, copywriting included</p>
        </div>
      </div>
      <p class="mx-auto max-w-6xl px-5 pb-12 text-sm text-white/50 sm:px-8">All prices exclude GST. <a href="/pricing/" class="underline underline-offset-4">Full pricing</a></p>
    </section>

    <!-- Writing -->
    <section id="writing" class="mx-auto max-w-6xl px-5 py-24 sm:px-8">
      <div class="flex items-baseline justify-between gap-6">
        <h2 class="serif text-4xl font-medium sm:text-5xl">Recent writing</h2>
        <a href="/blog/" class="font-semibold underline decoration-[#C2562D] decoration-2 underline-offset-4">All articles</a>
      </div>
      <ul class="mt-10 divide-y divide-[#16142E]/15 border-y border-[#16142E]/15">
        {posts.map((p) => (
          <li>
            <a href={`/blog/${p.id}/`} class="group grid gap-2 py-7 md:grid-cols-[160px_1fr] md:items-baseline">
              <span class="text-sm text-[#16142E]/55">{dateFormatter.format(p.data.publishDate)}</span>
              <span class="serif text-2xl leading-snug group-hover:text-[#C2562D]">{p.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- CTA -->
    <section class="mx-auto max-w-6xl px-5 pb-24 sm:px-8">
      <div class="grid gap-10 rounded-sm bg-[#EFE6DA] p-10 sm:p-16 md:grid-cols-[1.5fr_1fr] md:items-center">
        <h2 class="serif text-4xl font-medium leading-tight sm:text-5xl">Curious where you stand? Ask me.</h2>
        <div>
          <p class="leading-relaxed text-[#16142E]/75">Free, no obligation, and you’ll hear back from me personally.</p>
          <a href="/contact/" class="mt-6 inline-block rounded-full bg-[#C2562D] px-7 py-4 font-semibold text-white hover:bg-[#16142E]">Get a free audit</a>
        </div>
      </div>
    </section>

    <footer class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 border-t border-[#16142E]/15 px-5 py-10 text-sm text-[#16142E]/60 sm:px-8">
      <span>© Kwantum · Ascot Vale, Melbourne</span>
      <span>{SITE.email} · {SITE.phoneDisplay}</span>
    </footer>

    <style>
      body { font-family: 'Inter Variable', system-ui, sans-serif; }
      h1, h2, h3 { color: inherit; }
      .serif { font-family: 'Fraunces Variable', Georgia, serif; font-optical-sizing: auto; }
    </style>
  </body>
</html>
