---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Thanks — We've Got Your Message | Kwantum"
  description="Thanks for reaching out to Kwantum. We'll be in touch shortly."
  noindex={true}
>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-5 py-24 text-center sm:px-8">
    <span class="motion-pop sticker flex h-24 w-24 rotate-[-6deg] items-center justify-center rounded-[1.75rem] border-2 border-ink bg-sun text-ink" style="--d:100ms">
      <Icon name="lucide:check" class="h-12 w-12" stroke-width="3" />
    </span>
    <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
      Thanks, I’ve got your message.
    </h1>
    <p class="mt-5 text-lg text-slate-600">
      I’ll take a look at how your business shows up and get back to you with your free visibility
      audit. No obligation, no jargon.
    </p>
    <a
      href="/"
      class="btn btn-lg bg-ink text-white mt-8"
    >
          <span>Back to homepage</span>
          <span class="btn-dot bg-sun text-ink" aria-hidden="true">→</span>
        </a>
  </section>

  <!--
    Fires once, only on a genuine successful contact-form submission (this page is only
    reachable via the contact form Worker's redirect). Uses GA4's recommended "generate_lead"
    event name. The base gtag() function is defined synchronously in BaseLayout.astro, so it's
    safe to call here even before the external gtag.js script has finished loading.
  -->
  <script is:inline>
    if (typeof gtag === 'function') {
      gtag('event', 'generate_lead', {
        event_category: 'contact_form',
        event_label: 'free_audit_request',
      });
    }
  </script>
</BaseLayout>
