---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';
---

<BaseLayout
  title="Message Not Sent | Kwantum"
  description="Something went wrong sending your message to Kwantum."
  noindex={true}
>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-5 py-24 text-center sm:px-8">
    <span class="motion-pop sticker flex h-24 w-24 rotate-[5deg] items-center justify-center rounded-[1.75rem] border-2 border-ink bg-coral text-ink" style="--d:100ms">
      <Icon name="lucide:alert-triangle" class="h-11 w-11" />
    </span>
    <h1 class="mt-6 font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">
      Sorry, your message didn't send
    </h1>
    <p class="mt-4 text-slate-500">
      Please check your name, email and message are filled in and try again, or email us directly
      at <a href={`mailto:${SITE.email}`} class="font-medium text-ink underline decoration-teal decoration-2 underline-offset-4 hover:decoration-4">{SITE.email}</a>.
    </p>
    <a
      href="/contact/"
      class="btn btn-lg bg-ink text-white mt-8"
    >
          <span>Back to the contact form</span>
          <span class="btn-dot bg-sun text-ink" aria-hidden="true">→</span>
        </a>
  </section>
</BaseLayout>
