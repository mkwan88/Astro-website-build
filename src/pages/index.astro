---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroMap from '../components/HeroMap.astro';
import Marquees from '../components/Marquees.astro';
import FounderCard from '../components/FounderCard.astro';
import AuditCard from '../components/AuditCard.astro';
import CtaSection from '../components/CtaSection.astro';
import { organizationSchema } from '../lib/schema';

const headline = 'Be the first choice in your area.';
const promises = ['Outrank your competitors.', 'Be more visible.', 'Get more clients.', 'Grow your business.'];

const services = [
  {
    label: 'Local SEO',
    title: 'Show up on the map.',
    body: 'Your Google Business Profile set up properly: categories, services, suburbs, photos and a simple way to win more reviews.',
    link: '/services/local-seo/',
    bg: 'bg-sun',
    dot: 'bg-ink text-sun',
  },
  {
    label: 'Websites',
    title: 'Win the search.',
    body: 'Pages built around what people in your area actually type, like “emergency plumber Moonee Ponds”, on a fast website you own.',
    link: '/services/website-design/',
    bg: 'bg-teal',
    dot: 'bg-ink text-teal',
  },
  {
    label: 'AI search',
    title: 'Get named by AI.',
    body: 'Clear, structured information so ChatGPT, Gemini and Google’s AI answers can understand your business and mention it.',
    link: '/services/ai-search-visibility/',
    bg: 'bg-coral',
    dot: 'bg-ink text-coral',
  },
];

const painPoints = [
  { text: 'My website is fine, but it isn’t bringing in any new customers.', bg: 'bg-white', tilt: -2 },
  { text: 'I searched for my own business and couldn’t find it. My competitor was right at the top.', bg: 'bg-sun', tilt: 1.5 },
  { text: 'Whoever built my site years ago isn’t answering their phone anymore.', bg: 'bg-teal', tilt: -1 },
  { text: 'I just want someone who handles it properly and picks up when I call.', bg: 'bg-coral', tilt: 2 },
];

const industries = [
  { label: 'Tradies', href: '/industries/seo-for-tradies/' },
  { label: 'Electricians', href: '/industries/seo-for-electricians/' },
  { label: 'Plumbers', href: '/industries/seo-for-plumbers/' },
];

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
const dateFormatter = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="SEO Agency Melbourne | Local SEO & Web Design — Kwantum"
  description="Melbourne SEO consultant in Ascot Vale. Local SEO, Google Business Profile and fast websites that get small businesses found on Google, Maps & AI. Free audit."
  schema={[organizationSchema()]}
>
  <!-- Hero -->
  <section class="mx-auto grid max-w-7xl items-center gap-12 px-5 pb-20 pt-8 sm:px-8 lg:grid-cols-[1.1fr_1fr] lg:pt-14">
    <div>
      <p class="motion-rise inline-flex items-center gap-2 rounded-full bg-white px-4 py-2 text-sm font-semibold text-ink shadow-sm" style="--d:0ms">
        <span class="motion-pulse h-2.5 w-2.5 rounded-full bg-teal"></span>
        Local SEO from Ascot Vale, Melbourne
      </p>
      <!-- Cycles through the promises above the H1; the H1 itself stays one stable line for search. -->
      <p class="motion-rise mt-8 font-display text-2xl font-extrabold tracking-tight text-ink sm:text-3xl" style="--d:100ms">
        <span class="sr-only">{promises.join(' ')}</span>
        <span data-rotator class="inline-grid rounded-xl bg-sun px-3 py-1 -rotate-1" aria-hidden="true">
          {promises.map((line, i) => (
            <span data-rotator-item class:list={['rotator-item col-start-1 row-start-1', i === 0 && 'is-active']}>{line}</span>
          ))}
        </span>
      </p>
      <h1 class="mt-4 font-display text-[3.25rem] font-extrabold leading-[0.98] tracking-tight sm:text-7xl" aria-label={headline}>
        {headline.split(' ').map((word, i) => (
          <><span class="motion-rise inline-block" aria-hidden="true" style={`--d:${120 + i * 70}ms`}>{word}</span>{' '}</>
        ))}
      </h1>
      <p class="motion-rise mt-7 max-w-xl text-lg leading-relaxed text-slate-600" style="--d:620ms">
        I help small businesses show up on Google, in Google Maps and in AI answers, so locals
        searching for what you do or sell find you first, and choose you.
      </p>
      <div class="motion-rise mt-9 flex flex-wrap items-center gap-5" style="--d:760ms">
        <a href="/contact/" class="btn btn-lg bg-ink text-white">
          <span>Get a free audit</span>
          <span class="btn-dot motion-nudge bg-sun text-ink" aria-hidden="true">→</span>
        </a>
        <a href="#audit" class="squiggle text-[15px] font-semibold text-ink">What’s in the audit?</a>
      </div>
    </div>
    <HeroMap />
  </section>

  <Marquees />

  <!-- Services -->
  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8">
    <h2 data-reveal class="max-w-2xl font-display text-4xl font-extrabold leading-tight tracking-tight sm:text-5xl">
      Three places your next customer looks.
    </h2>
    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {services.map((s, i) => (
        <a href={s.link} data-reveal class={`tilt-card group flex min-h-[340px] flex-col justify-between rounded-[2rem] p-8 text-ink ${s.bg}`} style={`--tilt:${[-1.2, 0.8, -0.6][i]}deg; --d:${i * 140}ms`}>
          <div>
            <p class="text-sm font-bold uppercase tracking-wider">{s.label}</p>
            <h3 class="mt-4 font-display text-3xl font-extrabold leading-tight">{s.title}</h3>
            <p class="mt-4 leading-relaxed">{s.body}</p>
          </div>
          <span class={`mt-8 flex h-12 w-12 items-center justify-center rounded-full text-xl font-bold transition-transform group-hover:translate-x-1 ${s.dot}`} aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    <p class="mt-10 text-slate-600">
      Also see: <a href="/services/google-business-profile-optimization/" class="squiggle font-semibold text-ink">Google Business Profile optimisation</a>
    </p>
  </section>

  <!-- Pain points -->
  <section class="bg-sand py-24">
    <div class="mx-auto max-w-7xl px-5 sm:px-8">
      <h2 data-reveal class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Sound familiar?</h2>
      <p class="mt-4 max-w-xl text-lg text-slate-600">The site is live. It just isn’t working for you.</p>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {painPoints.map((p, i) => (
          <blockquote data-reveal class={`tilt-card relative rounded-[1.75rem] p-7 text-lg font-medium leading-relaxed text-ink ${p.bg}`} style={`--tilt:${p.tilt}deg; --d:${i * 110}ms`}>
            <span class="font-display text-5xl leading-none text-ink/30" aria-hidden="true">“</span>
            <p class="-mt-4">{p.text}</p>
          </blockquote>
        ))}
      </div>
      <p data-reveal class="mt-12 max-w-2xl text-lg leading-relaxed text-slate-700">
        Kwantum fixes that. I get local businesses found on Google, in Google Maps and in AI answers,
        and I stay on after launch to keep it working. A new website is sometimes part of the job, but
        the goal is more calls and enquiries.
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3">
        <span class="text-sm font-semibold text-slate-600">I work with:</span>
        {industries.map((ind) => (
          <a href={ind.href} class="rounded-full border-2 border-ink bg-white px-4 py-2 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-sun">{ind.label}</a>
        ))}
        <a href="/areas/melbourne/" class="rounded-full border-2 border-ink bg-white px-4 py-2 text-sm font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-sun">Melbourne businesses</a>
      </div>
    </div>
  </section>

  <div class="pt-24">
    <FounderCard />
  </div>

  <AuditCard />

  <!-- Pricing strip -->
  <section class="mx-auto max-w-7xl px-5 py-24 sm:px-8">
    <h2 data-reveal class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Prices on the page.</h2>
    <div data-reveal class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-[2rem] border-2 border-ink bg-white p-8 sm:p-10">
        <p class="text-sm font-bold uppercase tracking-wider text-ink">Ongoing SEO</p>
        <p class="mt-3 font-display text-5xl font-extrabold text-ink">From $<span data-count="1000">1,000</span><span class="text-2xl">/month</span></p>
        <p class="mt-3 text-slate-600">Month to month. No lock-in contracts.</p>
      </div>
      <div class="rounded-[2rem] border-2 border-ink bg-white p-8 sm:p-10">
        <p class="text-sm font-bold uppercase tracking-wider text-ink">New website</p>
        <p class="mt-3 font-display text-5xl font-extrabold text-ink">From $<span data-count="1490">1,490</span></p>
        <p class="mt-3 text-slate-600">One-off. Copywriting included. Yours once it launches.</p>
      </div>
    </div>
    <p class="mt-6 text-sm text-slate-500">All prices exclude GST.</p>
    <a href="/pricing/" class="squiggle mt-4 inline-block font-semibold text-ink">See full pricing and what’s included</a>
  </section>

  <!-- Blog -->
  <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <h2 data-reveal class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Straight answers, written down.</h2>
      <a href="/blog/" class="squiggle font-semibold text-ink">All articles</a>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {posts.map((p, i) => (
        <a data-reveal style={`--d:${i * 120}ms`} href={`/blog/${p.id}/`} class="group overflow-hidden rounded-[2rem] bg-white transition-transform hover:-translate-y-1">
          <Image src={p.data.heroImage} alt={p.data.heroImageAlt} width={800} height={450} class="aspect-video w-full object-cover" />
          <div class="p-7">
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">{dateFormatter.format(p.data.publishDate)}</p>
            <h3 class="mt-2 font-display text-xl font-bold leading-snug decoration-teal decoration-4 underline-offset-4 group-hover:underline">{p.data.title}</h3>
          </div>
        </a>
      ))}
    </div>
  </section>

  <CtaSection />
</BaseLayout>

<style>
  .rotator-item { opacity: 0; translate: 0 0.6em; transition: opacity 0.35s ease, translate 0.45s cubic-bezier(0.34, 1.56, 0.64, 1); }
  .rotator-item.is-active { opacity: 1; translate: 0 0; }
  .rotator-item.is-leaving { opacity: 0; translate: 0 -0.6em; }
</style>

<script>
  // Swap the highlighted promise every few seconds. All lines share one grid cell, so the box is
  // always as wide as the longest line and nothing around it shifts.
  document.querySelectorAll<HTMLElement>('[data-rotator]').forEach((rotator) => {
    const items = [...rotator.querySelectorAll<HTMLElement>('[data-rotator-item]')];
    if (items.length < 2 || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let i = 0;
    setInterval(() => {
      const current = items[i];
      i = (i + 1) % items.length;
      current.classList.replace('is-active', 'is-leaving');
      setTimeout(() => current.classList.remove('is-leaving'), 450);
      items[i].classList.add('is-active');
    }, 2600);
  });
</script>
