---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSignal from '../components/HeroSignal.astro';
import ServicesGrid from '../components/ServicesGrid.astro';
import VisibilityChannels from '../components/VisibilityChannels.astro';
import PricingTable from '../components/PricingTable.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE } from '../lib/site';
import { organizationSchema } from '../lib/schema';
import collaborationImage from '../assets/generated/about-collaboration-hands.png';
import markPortrait from '../assets/team/mark-kwan-portrait.jpg';

const painPoints = [
  "My website is fine, but it isn't bringing in any new customers.",
  "I searched for my own business on Google and couldn't find it — my competitor was right at the top.",
  "Whoever built my site years ago isn't answering their phone anymore.",
  "I just want someone who handles it properly and picks up when I call.",
];
---

<BaseLayout
  title="Kwantum — Local SEO & Websites That Get You Found"
  description={SITE.description}
  schema={[organizationSchema()]}
  transparentHeader
>
  <HeroSignal />

  <!-- Pain points -->
  <section class="bg-white py-20">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 class="font-display text-3xl font-bold text-slate-900 sm:text-4xl">Does this sound familiar?</h2>
      <p class="mt-4 text-slate-500">The site is live. It just isn't working for you.</p>

      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          painPoints.map((point) => (
            <blockquote
              data-spotlight
              class="group relative overflow-hidden rounded-2xl border border-slate-100 bg-slate-50 p-6 text-left text-sm leading-relaxed text-slate-600 transition duration-300 ease-out hover:border-brand-200 hover:bg-white hover:shadow-xl hover:shadow-brand-600/10 hover:ring-1 hover:ring-brand-300/50 motion-safe:hover:-translate-y-1 motion-safe:hover:scale-[1.03] motion-safe:active:scale-[0.98]"
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100"
                style="background: radial-gradient(260px circle at var(--mx, 50%) var(--my, 50%), rgb(79 70 229 / 0.1), transparent 70%);"
              ></span>
              <span class="relative block">
                <Icon name="lucide:quote" class="mb-2 h-5 w-5 text-brand-300 transition-colors duration-300 group-hover:text-accent-500" />
                <span class="transition-colors duration-300 group-hover:text-slate-800">{point}</span>
              </span>
            </blockquote>
          ))
        }
      </div>

      <p class="mt-10 text-slate-600">
        That's exactly why Kwantum exists: to put your business in the spotlight — found on
        Google, AI and by customers already looking for you. A website is one way we help you get
        there, but not the whole point. We work hand in hand with you the entire way, not just to
        launch day.
      </p>
      <a
        href="/contact/"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white shadow-sm transition-colors hover:bg-brand-700"
      >
        Get My Free Audit
      </a>
    </div>
  </section>

  <ServicesGrid />

  <VisibilityChannels />

  <CtaSection />

  <!-- About teaser -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-10 rounded-3xl bg-slate-50 p-10 lg:grid-cols-2 lg:items-center lg:p-14">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">Who's behind Kwantum</p>
        <h2 class="mt-2 font-display text-3xl font-bold text-slate-900">
          A small, hands-on team — not a call centre
        </h2>
        <p class="mt-4 text-sm leading-relaxed text-slate-600">
          Kwantum is built to be the opposite of the agency experience most small businesses
          dread: no ticket queues, no account manager who's never heard of you. You get a website
          and search strategy built properly, and a team that's still there after launch.
        </p>
        <div class="mt-6 flex items-center gap-3">
          <Image
            src={markPortrait}
            alt="Mark Kwan, founder of Kwantum"
            width={144}
            height={144}
            class="h-[70px] w-[70px] rounded-full object-cover ring-2 ring-white shadow-md"
          />
          <div>
            <p class="font-display text-sm font-semibold text-slate-900">Mark Kwan</p>
            <p class="text-xs text-slate-500">Founder, Kwantum</p>
          </div>
        </div>
        <a href="/about/" class="mt-6 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 hover:gap-2 transition-all">
          More about Kwantum
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>
      </div>
      <div class="overflow-hidden rounded-2xl shadow-xl shadow-brand-900/10">
        <Image
          src={collaborationImage}
          alt="Two people working together at a laptop, one pointing at an analytics dashboard while the other sketches a website plan"
          width={900}
          height={675}
          class="h-full w-full object-cover"
        />
      </div>
    </div>
  </section>

  <PricingTable />

  <!-- Areas teaser -->
  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">Areas we serve</p>
      <h2 class="mt-2 font-display text-3xl font-bold text-slate-900 sm:text-4xl">
        Local everywhere we work
      </h2>
      <p class="mt-4 text-sm text-slate-500">
        Based in Melbourne, expanding city by city — with a genuinely local approach for each one.
      </p>
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a href="/areas/melbourne/" class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600">
        Melbourne
      </a>
      <a href="/areas/" class="rounded-full bg-brand-50 px-5 py-2.5 text-sm font-semibold text-brand-700 hover:bg-brand-100">
        View all areas &rarr;
      </a>
    </div>
  </section>

  <CtaSection
    heading="Bring us your current site — or your idea"
    body="You'll get an honest, no-obligation read on what's working, what's costing you enquiries, and exactly what to do next."
  />
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((tile) => {
    tile.addEventListener('pointermove', (event) => {
      const rect = tile.getBoundingClientRect();
      tile.style.setProperty('--mx', `${event.clientX - rect.left}px`);
      tile.style.setProperty('--my', `${event.clientY - rect.top}px`);
    });
  });
</script>
