---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { SITE } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';

const caseStudies = (await getCollection('caseStudies')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const crumbs = [{ name: 'Case Studies', href: '/case-studies/' }];
---

<BaseLayout
  title="Case Studies | Kwantum"
  description="Real-world (and illustrative) examples of how Kwantum's local SEO and website work translates into measurable results."
  schema={[breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` })))]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h1 class="font-display text-4xl font-extrabold text-slate-900 sm:text-5xl">Case Studies</h1>
    <p class="mt-5 text-lg text-slate-600">
      What the work actually looks like once it's done — the problem, the approach, and the result.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2">
      {
        caseStudies.map((cs) => (
          <a
            href={`/case-studies/${cs.id}/`}
            class="group overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm transition-shadow hover:shadow-lg"
          >
            <Image src={cs.data.heroImage} alt={cs.data.heroImageAlt} width={800} height={450} class="h-56 w-full object-cover" />
            <div class="p-7">
              {cs.data.isPlaceholder && (
                <span class="mb-2 inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
                  Illustrative example
                </span>
              )}
              <p class="text-xs font-medium uppercase tracking-wide text-slate-400">{cs.data.industry}</p>
              <h2 class="mt-1 font-display text-xl font-bold text-slate-900">{cs.data.clientName}</h2>
              <p class="mt-3 font-display text-lg font-bold text-accent-600">{cs.data.headlineResult}</p>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{cs.data.summary}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-brand-600 group-hover:underline">
                Read the case study &rarr;
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CtaSection />
</BaseLayout>
