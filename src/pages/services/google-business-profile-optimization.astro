---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import PricingTable from '../../components/PricingTable.astro';
import Faq from '../../components/Faq.astro';
import CtaSection from '../../components/CtaSection.astro';
import { SITE } from '../../lib/site';
import { serviceSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

const title = 'Google Business Profile Optimization Melbourne | Kwantum';
const description =
  'Google Business Profile optimization for Melbourne businesses: profile setup, reviews and website link, then managed monthly. Free audit.';
const pageUrl = `${SITE.url}/services/google-business-profile-optimization/`;

const signs = [
  'Your website isn’t linked, or the link goes to a page that doesn’t match what the customer searched for.',
  'The wrong categories are set, or only one.',
  'A competitor has more reviews, or newer reviews, than you.',
  'You’ve got no photos, or only a few old ones.',
  'You don’t list your services, or the list is a single line.',
  'You work from a van or home and aren’t sure how to set up your service area.',
  'You’ve ended up with two profiles for the same business.',
  'You don’t show up when someone asks Google or an AI assistant for a recommendation nearby.',
];

const whatWeDo = [
  {
    title: 'Overhaul the profile',
    description:
      'Primary and secondary categories, services with real descriptions, service areas, business description, hours, attributes and photos. Everything is set up so Google understands what you do and where.',
  },
  {
    title: 'Connect your website properly',
    description:
      'We link your site to your profile with tracking, so you can see which calls and visits come from Google. If the page your profile links to isn’t the best one, we say so.',
  },
  {
    title: 'Build a review system',
    description:
      'A short review link, a QR code for your van, counter or invoices, and ready-to-send SMS and email requests your team can use from day one, plus reply templates for good and bad reviews. We never write or buy reviews. Google detects it, and it can get your profile suspended.',
  },
  {
    title: 'Clean up your directory listings',
    description:
      'We check your name, address and phone number across the major Australian directories and fix the top mismatches. Google trusts consistent details.',
  },
  {
    title: 'Keep it working, and show you the result',
    description:
      'Regular updates and posts, review requests and replies, and a plain-English monthly report on where you rank on Google Maps and the enquiries coming in.',
  },
];

const phases = [
  {
    title: 'Phase 1: Free audit',
    description:
      'We look at your profile, your website and how you show up on Google Maps compared with nearby competitors. You get a straight read on what’s working, what’s costing you enquiries and what to fix first. No obligation.',
  },
  {
    title: 'Phase 2: Setup',
    description:
      'A one-off job at the start. We overhaul your profile, link and track your website, put your review system in place and clean up your directory listings. We also record where you rank today for the searches that matter to you, so there’s a baseline to measure against.',
  },
  {
    title: 'Phase 3: Ongoing',
    description:
      'Each month we keep the profile current, post updates, handle review requests and replies, and keep your listings consistent. You get a monthly report in plain English: rankings, visibility and enquiries. We adjust based on what’s working.',
  },
];

const needs = [
  'Manager access to your Google Business Profile (we show you how in two minutes)',
  'A 20-minute kick-off call',
  '10 to 20 recent photos of your team, vehicles, premises or work',
];

const faq = [
  {
    question: 'Is it safe to give you access to my profile?',
    answer:
      'Yes. You stay the owner. We ask to be added as a manager, which lets us edit the profile but not remove you. You can take our access away at any time. We show you how to add us, in about two minutes.',
  },
  {
    question: 'What’s the difference between Google My Business and Google Business Profile?',
    answer:
      'Nothing important. Google renamed Google My Business to Google Business Profile. You may still see the old name in places.',
  },
  {
    question: 'Optimization or optimisation?',
    answer:
      'They mean the same thing. We use the Australian spelling in our writing, but many people search with a “z”, so you’ll see both.',
  },
  {
    question: 'Can you help if my profile was suspended?',
    answer:
      'Sometimes. Suspensions often come from address, name or category problems, and fixing them is part of what we look at. We can’t promise Google will reinstate it, so we tell you what we find first.',
  },
  {
    question: 'I have two profiles for the same business. What now?',
    answer:
      'Duplicates split your reviews and confuse Google. We help you pick the right one to keep (usually the verified one with reviews) and remove or merge the other.',
  },
  {
    question: 'Do I need a shopfront?',
    answer:
      'No. If you work from a van or home, Google lets you set up a service-area business that shows the suburbs you cover instead of your address. We set that up properly.',
  },
  {
    question: 'How many reviews do I need?',
    answer:
      'There’s no magic number. What matters is that you have more recent, genuine reviews than the businesses ranking above you, and keep getting new ones. We show you where you stand against your competitors in the audit.',
  },
  {
    question: 'How long until I see results?',
    answer:
      'Rankings move over weeks and months depending on your area and your competitors. That’s why we record where you rank at the start and report on it every month.',
  },
  {
    question: 'How is this different from your Local SEO service?',
    answer:
      'Your Google Business Profile is one part of local SEO. Every plan includes the profile setup and optimisation. The higher plans add more: regular posting, content, link building and a full local pack strategy.',
  },
];

const crumbs = [
  { name: 'Services', href: '/services/' },
  { name: 'Google Business Profile Optimization', href: '/services/google-business-profile-optimization/' },
];
---

<BaseLayout
  title={title}
  description={description}
  schema={[
    serviceSchema({ name: 'Google Business Profile Optimization', description, url: pageUrl }),
    breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` }))),
    faqSchema(faq),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="bg-gradient-to-b from-brand-50/60 to-white">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
      <h1 class="font-display text-4xl font-extrabold text-slate-900 sm:text-5xl">
        Google Business Profile optimisation, done for you
      </h1>
      <p class="mt-5 text-lg leading-relaxed text-slate-600">
        Your Google Business Profile is often the first thing a customer sees: your name, rating, photos and a phone
        number, before they’ve visited your website. If it’s incomplete or set up wrongly, you lose enquiries to a
        competitor who isn’t any better than you, just better optimised.
      </p>
      <p class="mt-4 text-lg leading-relaxed text-slate-600">
        Kwantum sets your profile up the way Google ranks local businesses, then keeps it working month after month.
      </p>
      <a
        href="/contact/"
        class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 hover:bg-brand-700"
      >
        Get My Free Audit
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
      <p class="mt-3 text-sm text-slate-500">Free, no obligation. A straight read on what your profile is missing.</p>
    </div>
  </section>

  <!-- Signs -->
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">Signs your profile needs work</h2>
    <ul class="mt-6 space-y-3">
      {
        signs.map((s) => (
          <li class="flex items-start gap-3 text-slate-600">
            <Icon name="lucide:check-circle-2" class="mt-0.5 h-5 w-5 shrink-0 text-accent-600" />
            {s}
          </li>
        ))
      }
    </ul>
    <p class="mt-6 text-slate-600">If you tick two or more, fixing them will make a noticeable difference.</p>
  </section>

  <!-- What we do -->
  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">What we do</h2>
      <div class="mt-8 grid gap-6 sm:grid-cols-2">
        {
          whatWeDo.map((item) => (
            <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
              <Icon name="lucide:check-circle-2" class="h-6 w-6 text-accent-600" />
              <h3 class="mt-3 font-display font-semibold text-slate-900">{item.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{item.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Phases -->
  <section class="mx-auto max-w-7xl px-4 py-16 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">How we work together</h2>
    <p class="mt-3 max-w-2xl text-slate-600">
      We work in three phases. You always know what’s happening and what’s next.
    </p>
    <ol class="mt-8 grid gap-6 md:grid-cols-3">
      {
        phases.map((phase, i) => (
          <li class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
            <span class="font-display text-3xl font-extrabold text-brand-100">{i + 1}</span>
            <h3 class="mt-2 font-display font-semibold text-slate-900">{phase.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">{phase.description}</p>
          </li>
        ))
      }
    </ol>

    <div class="mt-10 rounded-2xl border border-slate-100 bg-slate-50 p-6">
      <h3 class="font-display font-semibold text-slate-900">What you need to give us</h3>
      <ul class="mt-4 space-y-2">
        {
          needs.map((n) => (
            <li class="flex items-start gap-2 text-sm text-slate-600">
              <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600" />
              {n}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Plans -->
  <section class="bg-slate-50 pt-4">
    <div class="mx-auto max-w-3xl px-4 pt-12 text-center sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">Plans and pricing</h2>
      <p class="mt-3 text-slate-600">
        Google Business Profile work is part of every Kwantum local SEO plan: a straight monthly price, plus a one-off
        setup fee, with no lock-in contract.
      </p>
    </div>
    <PricingTable />
    <div class="mx-auto max-w-3xl px-4 pb-16 text-center text-sm text-slate-600 sm:px-6 lg:px-8">
      <p>
        Getting a new website and only need the profile set up? Our one-off “Found on Google Maps” add-on covers it.
        See <a href="/pricing/" class="font-semibold text-brand-600 hover:underline">the full pricing page</a>.
      </p>
      <p class="mt-3">
        We guarantee the work, not rankings. Nobody can honestly promise a Google position, and you should be wary of
        anyone who does.
      </p>
    </div>
  </section>

  <!-- Who it's for -->
  <section class="mx-auto max-w-3xl px-4 py-14 sm:px-6 lg:px-8">
    <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">Who it’s for</h2>
    <p class="mt-4 leading-relaxed text-slate-600">
      Established Melbourne businesses whose customers love them, but whose Google presence doesn’t show it yet. For
      example pest control, vets, HVAC, electricians, plumbers and warehouse racking. If you rely on local customers
      finding you, this is built for you. Read more about our wider
      <a href="/services/local-seo/" class="font-semibold text-brand-600 hover:underline">local SEO service</a>.
    </p>
  </section>

  <Faq items={faq} />

  <CtaSection
    heading="Ready to fix your profile?"
    body="Get a free visibility audit: what your profile is missing, how you compare with nearby competitors and exactly what to fix."
  />
</BaseLayout>
