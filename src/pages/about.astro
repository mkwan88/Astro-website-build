---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE } from '../lib/site';
import { organizationSchema, breadcrumbSchema } from '../lib/schema';
import markPortrait from '../assets/team/mark-kwan-portrait.jpg';

const values = [
  {
    icon: 'lucide:message-circle',
    title: 'Plain English, always',
    description: "We translate what we do into language you'd actually use — no jargon to hide behind.",
  },
  {
    icon: 'lucide:gauge',
    title: 'Built to perform, not just look nice',
    description: 'Every site is judged on speed and search visibility, not just how it looks in a mockup.',
  },
  {
    icon: 'lucide:phone',
    title: 'A real person, not a ticket queue',
    description: "When you need something, you reach an actual person who already knows your business.",
  },
];

const crumbs = [{ name: 'About', href: '/about/' }];
---

<BaseLayout
  title="About Kwantum | SEO Consultant in Ascot Vale, Melbourne"
  description="Kwantum is a Melbourne SEO consultant and web design agency based in Ascot Vale, building fast websites and local SEO for businesses across Australia."
  schema={[organizationSchema(), breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` })))]}
>
  <Breadcrumbs items={crumbs} />

  <section class="overflow-hidden">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">About Kwantum</p>
        <h1 class="mt-2 font-display text-5xl font-extrabold leading-[1.02] tracking-tight text-ink sm:text-6xl">
          Built for businesses tired of being invisible online
        </h1>
        <p class="mt-6 text-lg leading-relaxed text-slate-600">
          Kwantum exists because too many good businesses lose customers to worse competitors with
          better search visibility. We're based in Melbourne and work with businesses across
          Australia, combining fast, modern website builds with the local SEO and AI-search work
          that actually gets you found.
        </p>
        <p class="mt-4 text-sm leading-relaxed text-slate-500">
          We keep things deliberately small and hands-on: one point of contact, plain-English
          explanations, and no disappearing after launch.
        </p>
      </div>
      <figure class="mx-auto w-full max-w-sm">
        <div class="relative">
          <div class="motion-wobble absolute -inset-4 rounded-[2.5rem] bg-teal" aria-hidden="true"></div>
          <Image src={markPortrait} alt="Mark Kwan, founder of Kwantum" width={424} height={424} class="relative w-full rounded-[2rem] object-cover" />
          <span class="chip motion-float absolute -bottom-5 -right-4 bg-sun" style="--r:-4deg; --d:0.4s">That’s me <span class="motion-wave">👋</span></span>
        </div>
        <figcaption class="mt-10 text-center text-sm text-slate-500">
          <span class="font-display font-semibold text-slate-900">Mark Kwan</span>, founder. Based in Ascot Vale, Melbourne.
        </figcaption>
      </figure>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-20 sm:px-6 lg:px-8">
    <h2 data-reveal class="font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">How we work</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {
        values.map((v) => (
          <div class="rounded-[1.75rem] bg-white p-7 shadow-sm">
            <Icon name={v.icon} class="h-8 w-8 text-brand-600" />
            <h3 class="mt-4 font-display font-semibold text-slate-900">{v.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-500">{v.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-20 text-center sm:px-6 lg:px-8">
    <h2 data-reveal class="font-display text-3xl font-extrabold tracking-tight text-ink sm:text-4xl">Based in Melbourne, working nationally</h2>
    <p class="mt-4 text-sm leading-relaxed text-slate-500">
      Our home base is Melbourne, but the local-SEO and website approach we've built works anywhere
      in Australia — we bring the same suburb-level, no-generic-templates thinking to every city
      we work in.
    </p>
    <a href="/areas/" class="squiggle mt-6 inline-block font-semibold text-ink">See areas we serve</a>
  </section>

  <CtaSection />
</BaseLayout>
