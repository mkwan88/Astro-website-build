---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import Faq from '../../components/Faq.astro';
import { SITE } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import markPortrait from '../../assets/team/mark-kwan-portrait.jpg';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedService = entry.data.relatedService ? await getEntry('services', entry.data.relatedService) : null;
const relatedArea = entry.data.relatedArea ? await getEntry('areas', entry.data.relatedArea) : null;

const dateFormatter = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

const crumbs = [
  { name: 'Blog', href: '/blog/' },
  { name: entry.data.title, href: `/blog/${entry.id}/` },
];
const pageUrl = `${SITE.url}/blog/${entry.id}/`;
---

<BaseLayout
  title={entry.data.metaTitle}
  description={entry.data.metaDescription}
  schema={[
    articleSchema({
      title: entry.data.title,
      description: entry.data.metaDescription,
      url: pageUrl,
      image: new URL(entry.data.heroImage.src, SITE.url).toString(),
      publishDate: entry.data.publishDate,
      updatedDate: entry.data.updatedDate,
      author: entry.data.author,
    }),
    breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` }))),
    faqSchema(entry.data.faq),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <article class="mx-auto max-w-3xl px-4 py-16 sm:px-6 lg:px-8">
    <div class="flex flex-wrap gap-2">
      {entry.data.tags.map((tag) => (
        <span class="rounded-full bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">{tag}</span>
      ))}
    </div>
    <h1 class="mt-4 font-display text-4xl font-extrabold text-slate-900 sm:text-5xl">{entry.data.title}</h1>
    <p class="mt-4 text-sm text-slate-400">
      By {entry.data.author} &middot; {dateFormatter.format(entry.data.publishDate)}
      {entry.data.updatedDate && <> &middot; Updated {dateFormatter.format(entry.data.updatedDate)}</>}
    </p>

    <Image src={entry.data.heroImage} alt={entry.data.heroImageAlt} width={900} height={506} class="mt-8 w-full rounded-2xl" />

    <div class="prose prose-slate prose-p:leading-relaxed prose-headings:font-display mt-10 max-w-none">
      <Content />
    </div>

    {
      entry.data.author === 'Mark Kwan' && (
        <aside class="mt-12 flex items-start gap-4 rounded-2xl border border-slate-100 bg-slate-50 p-6">
          <Image
            src={markPortrait}
            alt="Mark Kwan, founder of Kwantum"
            width={128}
            height={128}
            class="h-16 w-16 shrink-0 rounded-full object-cover ring-2 ring-white shadow-md"
          />
          <div>
            <p class="font-display text-sm font-semibold text-slate-900">Written by Mark Kwan</p>
            <p class="mt-1 text-sm leading-relaxed text-slate-600">
              Mark is the founder of Kwantum, a Melbourne-based local SEO and website studio. He helps
              Australian businesses get found in Google Maps, local search and AI-generated answers.
            </p>
            <a href="/about/" class="mt-2 inline-block text-sm font-semibold text-brand-600 hover:underline">
              More about Kwantum
            </a>
          </div>
        </aside>
      )
    }

    {
      (relatedService || relatedArea) && (
        <div class="mt-12 flex flex-wrap gap-3 border-t border-slate-100 pt-8">
          {relatedService && (
            <a href={`/services/${relatedService.id}/`} class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600">
              Explore {relatedService.data.title}
            </a>
          )}
          {relatedArea && (
            <a href={`/areas/${relatedArea.id}/`} class="rounded-full border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 hover:border-brand-300 hover:text-brand-600">
              Our work in {relatedArea.data.cityName}
            </a>
          )}
        </div>
      )
    }
  </article>

  <Faq items={entry.data.faq} title="Common questions" />

  <CtaSection />
</BaseLayout>
