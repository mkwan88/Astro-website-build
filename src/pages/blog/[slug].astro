---
import { getCollection, getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import Faq from '../../components/Faq.astro';
import { SITE } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import markPortrait from '../../assets/team/mark-kwan-portrait.jpg';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const relatedService = entry.data.relatedService ? await getEntry('services', entry.data.relatedService) : null;
const relatedArea = entry.data.relatedArea ? await getEntry('areas', entry.data.relatedArea) : null;

const dateFormatter = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });

const crumbs = [
  { name: 'Blog', href: '/blog/' },
  { name: entry.data.title, href: `/blog/${entry.id}/` },
];
const pageUrl = `${SITE.url}/blog/${entry.id}/`;
---

<BaseLayout
  title={entry.data.metaTitle}
  description={entry.data.metaDescription}
  schema={[
    articleSchema({
      title: entry.data.title,
      description: entry.data.metaDescription,
      url: pageUrl,
      image: new URL(entry.data.heroImage.src, SITE.url).toString(),
      publishDate: entry.data.publishDate,
      updatedDate: entry.data.updatedDate,
      author: entry.data.author,
    }),
    breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` }))),
    faqSchema(entry.data.faq),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <article class="mx-auto max-w-3xl px-5 py-12 sm:px-8">
    <div class="flex flex-wrap gap-2">
      {entry.data.tags.map((tag) => (
        <span class="rounded-full bg-teal px-3 py-1 text-sm font-semibold text-ink">{tag}</span>
      ))}
    </div>
    <h1 class="mt-5 font-display text-4xl font-extrabold leading-[1.05] tracking-tight text-ink sm:text-[3.4rem]">{entry.data.title}</h1>
    <p class="mt-5 text-slate-500">
      By {entry.data.author} &middot; {dateFormatter.format(entry.data.publishDate)}
      {entry.data.updatedDate && <> &middot; Updated {dateFormatter.format(entry.data.updatedDate)}</>}
    </p>

    <Image src={entry.data.heroImage} alt={entry.data.heroImageAlt} width={900} height={506} class="sticker mt-10 w-full rounded-[2rem] border-2 border-ink" />

    <div class="prose prose-lg prose-slate mt-12 max-w-none prose-headings:font-display prose-headings:font-extrabold prose-headings:tracking-tight prose-p:leading-relaxed prose-a:font-semibold prose-a:text-ink prose-a:decoration-teal prose-a:decoration-2 prose-a:underline-offset-4 hover:prose-a:decoration-4 prose-strong:text-ink prose-img:rounded-[1.5rem] prose-img:border-2 prose-img:border-ink prose-li:marker:text-coral">
      <Content />
    </div>

    {
      entry.data.author === 'Mark Kwan' && (
        <aside class="mt-14 flex items-start gap-5 rounded-[2rem] bg-white p-7">
          <Image
            src={markPortrait}
            alt="Mark Kwan, founder of Kwantum"
            width={128}
            height={128}
            class="h-20 w-20 shrink-0 rounded-[1.2rem] object-cover ring-4 ring-teal"
          />
          <div>
            <p class="font-display text-lg font-bold text-ink">Written by Mark Kwan</p>
            <p class="mt-1 leading-relaxed text-slate-600">
              Mark is the founder of Kwantum, a Melbourne-based local SEO and website studio. He helps
              Australian businesses get found in Google Maps, local search and AI-generated answers.
            </p>
            <a href="/about/" class="squiggle mt-3 inline-block font-semibold text-ink">
              More about Kwantum
            </a>
          </div>
        </aside>
      )
    }

    {
      (relatedService || relatedArea) && (
        <div class="mt-12 flex flex-wrap gap-3 border-t-2 border-slate-200 pt-8">
          {relatedService && (
            <a href={`/services/${relatedService.id}/`} class="rounded-full border-2 border-ink bg-white px-5 py-2.5 font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-sun">
              Explore {relatedService.data.title}
            </a>
          )}
          {relatedArea && (
            <a href={`/areas/${relatedArea.id}/`} class="rounded-full border-2 border-ink bg-white px-5 py-2.5 font-semibold text-ink transition hover:-translate-y-0.5 hover:bg-sun">
              Our work in {relatedArea.data.cityName}
            </a>
          )}
        </div>
      )
    }
  </article>

  <Faq items={entry.data.faq} title="Common questions" />

  <CtaSection />
</BaseLayout>
