---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { SITE } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const crumbs = [{ name: 'Blog', href: '/blog/' }];

const dateFormatter = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Blog | Kwantum"
  description="Plain-English guides on local SEO, website performance, and AI search visibility from Kwantum."
  schema={[breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` })))]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-7xl px-5 pb-12 pt-10 sm:px-8">
    <h1 class="motion-rise font-display text-5xl font-extrabold leading-[1.02] tracking-tight sm:text-7xl">Straight answers, written down.</h1>
    <p class="motion-rise mt-6 max-w-2xl text-lg text-slate-600" style="--d:120ms">Practical guides on local SEO, Google Maps, websites and AI search, from the work I do every week. No jargon.</p>
  </section>

  <section class="mx-auto max-w-7xl px-5 pb-24 sm:px-8">
    <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
      {
        posts.map((post, i) => (
          <a
            href={`/blog/${post.id}/`}
            data-reveal
            style={`--d:${(i % 3) * 110}ms`}
            class="group flex flex-col overflow-hidden rounded-[2rem] bg-white transition-transform hover:-translate-y-1"
          >
            <Image src={post.data.heroImage} alt={post.data.heroImageAlt} width={800} height={450} class="aspect-video w-full object-cover" />
            <div class="flex flex-1 flex-col p-7">
              <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
                {dateFormatter.format(post.data.publishDate)}
              </p>
              <h2 class="mt-2 font-display text-xl font-bold leading-snug decoration-teal decoration-4 underline-offset-4 group-hover:underline">{post.data.title}</h2>
              <p class="mt-3 flex-1 leading-relaxed text-slate-600">{post.data.excerpt}</p>
              <span class="mt-5 inline-flex items-center gap-2 font-semibold text-ink">
                Read it <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sun transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CtaSection />
</BaseLayout>
