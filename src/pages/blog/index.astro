---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { SITE } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
const crumbs = [{ name: 'Blog', href: '/blog/' }];

const dateFormatter = new Intl.DateTimeFormat('en-AU', { day: 'numeric', month: 'long', year: 'numeric' });
---

<BaseLayout
  title="Blog | Kwantum"
  description="Plain-English guides on local SEO, website performance, and AI search visibility from Kwantum."
  schema={[breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` })))]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h1 class="font-display text-4xl font-extrabold text-slate-900 sm:text-5xl">Blog</h1>
    <p class="mt-5 text-lg text-slate-600">Straight, practical guides — no jargon, no fluff.</p>
  </section>

  <section class="mx-auto max-w-5xl px-4 pb-20 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm transition-shadow hover:shadow-lg"
          >
            <Image src={post.data.heroImage} alt={post.data.heroImageAlt} width={800} height={450} class="h-48 w-full object-cover" />
            <div class="p-7">
              <p class="text-xs font-medium uppercase tracking-wide text-slate-400">
                {dateFormatter.format(post.data.publishDate)}
              </p>
              <h2 class="mt-2 font-display text-lg font-bold text-slate-900">{post.data.title}</h2>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{post.data.excerpt}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-brand-600 group-hover:underline">
                Read more &rarr;
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CtaSection />
</BaseLayout>
