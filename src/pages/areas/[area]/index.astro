---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import ServicesGrid from '../../../components/ServicesGrid.astro';
import Testimonials from '../../../components/Testimonials.astro';
import Faq from '../../../components/Faq.astro';
import CtaSection from '../../../components/CtaSection.astro';
import { SITE } from '../../../lib/site';
import { localBusinessSchema, breadcrumbSchema, faqSchema } from '../../../lib/schema';

export async function getStaticPaths() {
  const areas = await getCollection('areas');
  return areas.map((entry) => ({
    params: { area: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const isHomeBase = !!entry.data.addressLocality;
const mapQuery = encodeURIComponent(`${entry.data.cityName}, ${entry.data.region}`);

const crumbs = [
  { name: 'Areas We Serve', href: '/areas/' },
  { name: entry.data.cityName, href: `/areas/${entry.id}/` },
];
const pageUrl = `${SITE.url}/areas/${entry.id}/`;
---

<BaseLayout
  title={entry.data.metaTitle}
  description={entry.data.metaDescription}
  schema={[
    localBusinessSchema({ areaName: entry.data.cityName, suburbs: entry.data.suburbs, url: pageUrl, isHomeBase }),
    breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` }))),
    faqSchema(entry.data.faq),
  ]}
>
  <Breadcrumbs items={crumbs} />

  {
    entry.data.isPlaceholder && (
      <div class="bg-amber-50 px-4 py-3 text-center text-sm font-medium text-amber-800">
        This is a template page demonstrating our area-page pattern — not a live location yet.
      </div>
    )
  }

  <section class="overflow-hidden bg-gradient-to-b from-brand-50/60 to-white">
    <div class="mx-auto grid max-w-7xl gap-12 px-4 py-16 sm:px-6 lg:grid-cols-2 lg:items-center lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">{entry.data.region}</p>
        <h1 class="mt-2 font-display text-4xl font-extrabold text-slate-900 sm:text-5xl">
          Local SEO & Websites in {entry.data.cityName}
        </h1>
        <p class="mt-5 text-lg leading-relaxed text-slate-600">{entry.data.tagline}</p>
        <a
          href="/contact/"
          class="mt-8 inline-flex items-center gap-2 rounded-full bg-brand-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-brand-600/20 hover:bg-brand-700"
        >
          Get My Free Audit
          <Icon name="lucide:arrow-right" class="h-4 w-4" />
        </a>

        <div class="mt-10 flex items-center gap-4 border-t border-slate-100 pt-8">
          <span class="font-display text-3xl font-extrabold text-brand-600">{entry.data.proofStat.value}</span>
          <span class="text-sm text-slate-500">{entry.data.proofStat.label}</span>
        </div>
      </div>
      <div class="rounded-3xl border border-slate-100 bg-white p-4 shadow-xl">
        <Image src={entry.data.heroImage} alt={entry.data.heroImageAlt} width={900} height={675} class="w-full rounded-2xl" />
      </div>
    </div>
  </section>

  <!-- Local narrative -->
  <section class="mx-auto max-w-3xl px-4 py-14 text-slate-600 sm:px-6 lg:px-8 prose prose-slate prose-p:leading-relaxed">
    <Content />
  </section>

  <!-- Why local -->
  <section class="bg-slate-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">
        Why {entry.data.cityName} needs a different approach
      </h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          entry.data.whyLocalPoints.map((point) => (
            <div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
              <h3 class="font-display font-semibold text-slate-900">{point.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{point.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Suburbs -->
  <section class="mx-auto max-w-7xl px-4 py-14 sm:px-6 lg:px-8">
    <h2 class="font-display text-xl font-bold text-slate-900">
      We work with businesses across {entry.data.cityName}, including:
    </h2>
    <div class="mt-5 flex flex-wrap gap-3">
      {
        entry.data.suburbs.map((suburb) => (
          <span class="rounded-full border border-slate-200 bg-white px-4 py-2 text-sm text-slate-600">
            {suburb}
          </span>
        ))
      }
    </div>
  </section>

  <ServicesGrid areaId={entry.id} heading={`What we do in ${entry.data.cityName}`} />

  {
    isHomeBase && (
      <section class="mx-auto max-w-5xl px-4 pb-16 sm:px-6 lg:px-8">
        <h2 class="font-display text-xl font-bold text-slate-900">Find us</h2>
        <div class="mt-5 overflow-hidden rounded-2xl border border-slate-100 shadow-sm">
          <iframe
            title={`Map of ${entry.data.cityName}`}
            src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}
            width="100%"
            height="360"
            style="border:0"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          />
        </div>
      </section>
    )
  }

  <Testimonials areaFilter={entry.id} />

  <Faq items={entry.data.faq} title={`${entry.data.cityName} FAQs`} />

  <CtaSection />
</BaseLayout>
