---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { SITE } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';

const areas = await getCollection('areas');
const crumbs = [{ name: 'Areas We Serve', href: '/areas/' }];
---

<BaseLayout
  title="Areas We Serve | Kwantum"
  description="Kwantum is based in Melbourne and works with businesses across Australia — see the areas we currently serve."
  schema={[breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` })))]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h1 class="font-display text-5xl font-extrabold leading-[1.02] tracking-tight text-ink sm:text-6xl">Areas We Serve</h1>
    <p class="mt-5 text-lg text-slate-600">
      Home base in Melbourne, working with businesses Australia-wide. Every area page below reflects
      genuine, locally-specific knowledge — not a swapped-in city name.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2">
      {
        areas.map((area) => (
          <a
            href={`/areas/${area.id}/`}
            data-reveal
            class="group flex flex-col overflow-hidden rounded-[2rem] border-2 border-ink bg-white transition-transform hover:-translate-y-1"
          >
            <div class="relative flex h-56 flex-wrap content-center justify-center gap-2.5 overflow-hidden bg-indigo p-6" aria-hidden="true">
              <div class="motion-spin absolute -right-10 -top-10 h-40 w-40 rounded-full border-[10px] border-dashed border-sun/50"></div>
              {area.data.suburbs.slice(0, 9).map((suburb, i) => (
                <span class={`chip relative ${['bg-sun', 'bg-white', 'bg-teal', 'bg-coral'][i % 4]}`} style={`--r:${[-4, 3, -2, 5, -3][i % 5]}deg`}>{suburb}</span>
              ))}
            </div>
            <div class="flex flex-1 flex-col p-7">
              {area.data.isPlaceholder && (
                <span class="mb-2 inline-flex w-fit rounded-full bg-sun px-3 py-1 text-xs font-semibold text-ink">
                  Template page
                </span>
              )}
              <h2 class="font-display text-2xl font-extrabold">{area.data.cityName}</h2>
              <p class="mt-1 text-slate-500">{area.data.region}</p>
              <p class="mt-3 flex-1 leading-relaxed text-slate-600">{area.data.tagline}</p>
              <span class="mt-5 inline-flex items-center gap-2 font-semibold text-ink">
                Explore {area.data.cityName} <span class="flex h-8 w-8 items-center justify-center rounded-full bg-sun transition-transform group-hover:translate-x-1">→</span>
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CtaSection
    heading="Not in Melbourne?"
    body="Most of the work is done remotely, so I can help businesses anywhere in Australia. Get in touch and tell me where you are."
  />
</BaseLayout>
