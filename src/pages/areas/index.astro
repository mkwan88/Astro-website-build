---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaSection from '../../components/CtaSection.astro';
import { SITE } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/schema';

const areas = await getCollection('areas');
const crumbs = [{ name: 'Areas We Serve', href: '/areas/' }];
---

<BaseLayout
  title="Areas We Serve | Kwantum"
  description="Kwantum is based in Melbourne and works with businesses across Australia — see the areas we currently serve."
  schema={[breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` })))]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h1 class="font-display text-4xl font-extrabold text-slate-900 sm:text-5xl">Areas We Serve</h1>
    <p class="mt-5 text-lg text-slate-600">
      Home base in Melbourne, working with businesses Australia-wide. Every area page below reflects
      genuine, locally-specific knowledge — not a swapped-in city name.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-20 sm:px-6 lg:px-8">
    <div class="grid gap-8 md:grid-cols-2">
      {
        areas.map((area) => (
          <a
            href={`/areas/${area.id}/`}
            class="group overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-sm transition-shadow hover:shadow-lg"
          >
            <Image src={area.data.heroImage} alt={area.data.heroImageAlt} width={800} height={450} class="h-56 w-full object-cover" />
            <div class="p-7">
              {area.data.isPlaceholder && (
                <span class="mb-2 inline-flex rounded-full bg-amber-100 px-3 py-1 text-xs font-semibold text-amber-800">
                  Template page
                </span>
              )}
              <h2 class="font-display text-xl font-bold text-slate-900">{area.data.cityName}</h2>
              <p class="mt-1 text-sm text-slate-500">{area.data.region}</p>
              <p class="mt-3 text-sm leading-relaxed text-slate-500">{area.data.tagline}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-brand-600 group-hover:underline">
                Explore {area.data.cityName} &rarr;
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <CtaSection
    heading="Don't see your city yet?"
    body="We're expanding city by city. Get in touch and we'll let you know when — or start working with you Australia-wide today."
  />
</BaseLayout>
