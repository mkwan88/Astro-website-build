---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import PricingTable from '../components/PricingTable.astro';
import Faq from '../components/Faq.astro';
import CtaSection from '../components/CtaSection.astro';
import { SITE } from '../lib/site';
import { breadcrumbSchema, faqSchema } from '../lib/schema';

const websiteTiers = [
  {
    name: 'Essentials',
    blurb: 'A strong, professional single page',
    price: '$1,490',
    note: 'One-off · live in 7 days',
    features: ['1 page', 'Copywriting included', 'Mobile-optimised, fast by default', 'Contact or booking form'],
  },
  {
    name: 'Growth',
    blurb: 'A full multi-page site',
    price: '$2,990',
    note: 'One-off · live in 14 days',
    features: ['Up to 6 pages', 'Copywriting included', 'Custom design', 'Blog-ready structure'],
  },
  {
    name: 'Custom',
    blurb: 'Larger or more complex builds',
    price: 'From $5,900',
    note: 'One-off · timeline scoped to your project',
    features: ['7+ pages or custom functionality', 'Copywriting included', 'Full brand identity option', 'Multi-location structure'],
  },
];

const addOns = [
  {
    title: 'Visibility Package: a year-long head start',
    description:
      '12 blog articles — one per month, researched and written. A strong fit alongside a new website build or the Foundation SEO plan, which doesn’t include content by default.',
    features: [
      '800–1,000 words per article, internally linked',
      'Includes an FAQ section AI tools and Google can quote directly',
      'Targeted at the exact searches your customers use',
    ],
    price: '$1,290',
    priceNote: 'one-off, add-on to any website or Foundation SEO plan',
  },
  {
    title: 'Found on Google Maps',
    description:
      'A one-off Google Business Profile setup for anyone getting a new website without an ongoing SEO plan. (Already included in every SEO plan from Foundation up.)',
    features: [
      'New profile setup, or takeover of an existing one',
      'Categories, services, service area, hours & photos, done properly',
      'A review-request link you can send after every job',
    ],
    price: '$390',
    priceNote: 'one-off, for website-only clients',
  },
];

const faq = [
  {
    question: 'Do I have to sign a long contract for SEO?',
    answer: 'No — every SEO plan is month-to-month with no lock-in. We’d rather earn the right to keep your business every month than lock you into a term.',
  },
  {
    question: 'Can I get a website without an ongoing SEO plan?',
    answer: 'Yes — website design is a standalone, one-off project. You can add an SEO plan alongside it, or later, or not at all.',
  },
  {
    question: 'Can I get an SEO plan without a new website?',
    answer: 'Yes — most SEO clients already have a website. We work with what you’ve got and improve it as part of the plan.',
  },
  {
    question: 'What if I want both a new website and ongoing SEO?',
    answer: 'Get in touch and ask about bundling — there’s a discount for taking a website project and an SEO plan together.',
  },
  {
    question: 'Are these prices final?',
    answer: 'These are illustrative figures while Kwantum finalises its published pricing. Get in touch for a firm, current quote for your project.',
  },
];

const crumbs = [{ name: 'Pricing', href: '/pricing/' }];
---

<BaseLayout
  title="Pricing | Kwantum"
  description="Kwantum's pricing: monthly SEO plans with no lock-in, and website design priced separately as a one-off project. Illustrative pricing, confirmed on enquiry."
  schema={[
    breadcrumbSchema(crumbs.map((c) => ({ name: c.name, url: `${SITE.url}${c.href}` }))),
    faqSchema(faq),
  ]}
>
  <Breadcrumbs items={crumbs} />

  <section class="mx-auto max-w-4xl px-4 py-16 text-center sm:px-6 lg:px-8">
    <h1 class="font-display text-4xl font-extrabold text-slate-900 sm:text-5xl">Pricing</h1>
    <p class="mt-5 text-lg text-slate-600">
      Two separate things, priced honestly: ongoing SEO as a monthly plan, and website design as a
      one-off project. Buy either on its own, or both together.
    </p>
  </section>

  <PricingTable />

  <!-- Website design, standalone -->
  <section id="website-design" class="bg-slate-50 py-20 scroll-mt-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-sm font-semibold uppercase tracking-wide text-accent-600">Website Design</p>
        <h2 class="mt-2 font-display text-3xl font-bold text-slate-900 sm:text-4xl">
          A new website, priced as a project
        </h2>
        <p class="mt-4 text-sm text-slate-500">
          A one-off build fee — no ongoing commitment required. The site is yours once it launches.
        </p>
      </div>

      <div class="mt-12 grid gap-8 md:grid-cols-3">
        {
          websiteTiers.map((tier) => (
            <div class="flex flex-col rounded-3xl border border-slate-100 bg-white p-7 shadow-sm">
              <h3 class="font-display text-lg font-bold text-slate-900">{tier.name}</h3>
              <p class="mt-1 text-sm text-slate-500">{tier.blurb}</p>
              <p class="mt-5 font-display text-3xl font-extrabold text-slate-900">{tier.price}</p>
              <p class="text-xs text-slate-400">{tier.note}</p>
              <ul class="mt-5 flex-1 space-y-2.5">
                {tier.features.map((f) => (
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600" />
                    {f}
                  </li>
                ))}
              </ul>
              <a
                href="/contact/"
                class="mt-6 inline-flex items-center justify-center rounded-full bg-brand-600 px-5 py-2.5 text-sm font-semibold text-white hover:bg-brand-700"
              >
                Get My Free Audit
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Add-ons -->
  <section class="py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-display text-2xl font-bold text-slate-900 sm:text-3xl">Add-ons</h2>
      <div class="mt-8 grid gap-8 md:grid-cols-2">
        {
          addOns.map((addOn) => (
            <div class="rounded-2xl border border-slate-100 bg-white p-7 shadow-sm">
              <h3 class="font-display text-lg font-semibold text-slate-900">{addOn.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-slate-500">{addOn.description}</p>
              <ul class="mt-4 space-y-2">
                {addOn.features.map((f) => (
                  <li class="flex items-start gap-2 text-sm text-slate-600">
                    <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-accent-600" />
                    {f}
                  </li>
                ))}
              </ul>
              <p class="mt-5 font-display text-xl font-bold text-brand-600">{addOn.price}</p>
              <p class="text-xs text-slate-400">{addOn.priceNote}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Faq items={faq} />

  <CtaSection />
</BaseLayout>
