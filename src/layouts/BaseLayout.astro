---
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Schema from '../components/Schema.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
  schema?: Array<Record<string, unknown> | null | undefined>;
}

const { title, description, image, noindex, schema = [] } = Astro.props;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#FBF6EC" />
    <meta name="generator" content={Astro.generator} />

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-G4NQ6873VK"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-G4NQ6873VK');
    </script>

    <SeoHead title={title} description={description} image={image} noindex={noindex} />
    <Schema items={schema} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll reveals for any [data-reveal] element, plus count-ups for [data-count] inside it.
      // Content is only hidden once .js is on <html>, so it stays visible if scripts fail.
      const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
      document.documentElement.classList.add('js');

      const countUp = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        const start = performance.now();
        const tick = (now: number) => {
          const t = Math.min((now - start) / 1100, 1);
          el.textContent = Math.round(target * (1 - Math.pow(1 - t, 3))).toLocaleString('en-AU');
          if (t < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };

      const io = new IntersectionObserver(
        (entries) =>
          entries.forEach((e) => {
            // Reveal on entry, or if a fast scroll jumped straight past it.
            if (!e.isIntersecting && e.boundingClientRect.top > 0) return;
            e.target.classList.add('in');
            if (!reduced) e.target.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
            io.unobserve(e.target);
          }),
        { threshold: 0.15 }
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>
